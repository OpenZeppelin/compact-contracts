{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".github/actions/setup/action.yml"],
  "globalPassThroughEnv": [
    "GITHUB_ACTIONS",
    "GITHUB_OUTPUT",
    "GITHUB_STEP_SUMMARY",
    "MIDNIGHT_LIVE_KEEP_ENV",
    "MIDNIGHT_LIVE_TEST_PATTERN"
  ],
  "tasks": {
    "compile:crypto": {
      "dependsOn": ["^build"],
      "env": ["COMPACT_HOME", "SKIP_ZK"],
      "inputs": ["src/crypto/**/*.compact"],
      "outputLogs": "new-only",
      "outputs": ["artifacts/crypto/**"]
    },
    "compile:security": {
      "dependsOn": ["^build"],
      "env": ["COMPACT_HOME", "SKIP_ZK"],
      "inputs": ["src/security/**/*.compact"],
      "outputLogs": "new-only",
      "outputs": ["artifacts/security/**"]
    },
    "compile:utils": {
      "dependsOn": ["^build"],
      "env": ["COMPACT_HOME", "SKIP_ZK"],
      "inputs": ["src/utils/**/*.compact"],
      "outputLogs": "new-only",
      "outputs": ["artifacts/utils/**"]
    },
    "compile:access": {
      "dependsOn": ["^build", "compile:utils"],
      "env": ["COMPACT_HOME", "SKIP_ZK"],
      "inputs": ["src/access/**/*.compact", "src/utils/**/*.compact"],
      "outputLogs": "new-only",
      "outputs": ["artifacts/access/**"]
    },
    "compile:archive": {
      "dependsOn": ["^build", "compile:utils"],
      "env": ["COMPACT_HOME", "SKIP_ZK"],
      "inputs": ["src/archive/**/*.compact", "src/utils/**/*.compact"],
      "outputLogs": "new-only",
      "outputs": ["artifacts/archive/**"]
    },
    "compile:multisig": {
      "dependsOn": ["^build", "compile:utils", "compile:crypto"],
      "env": ["COMPACT_HOME", "SKIP_ZK"],
      "inputs": [
        "src/multisig/**/*.compact",
        "src/access/**/*.compact",
        "src/crypto/**/*.compact",
        "src/token/**/*.compact",
        "src/utils/**/*.compact"
      ],
      "outputLogs": "new-only",
      "outputs": ["artifacts/multisig/**"]
    },
    "compile:token": {
      "dependsOn": ["^build", "compile:utils", "compile:crypto"],
      "env": ["COMPACT_HOME", "SKIP_ZK"],
      "inputs": [
        "src/token/**/*.compact",
        "src/access/**/*.compact",
        "src/crypto/**/*.compact",
        "src/utils/**/*.compact"
      ],
      "outputLogs": "new-only",
      "outputs": ["artifacts/token/**"]
    },
    "compile:integration": {
      "dependsOn": ["^build"],
      "env": ["COMPACT_HOME", "SKIP_ZK"],
      "inputs": [
        "test/integration/**/*.compact",
        "src/**/*.compact",
        "!src/archive/**"
      ],
      "outputLogs": "new-only",
      "outputs": ["artifacts/integration/**"]
    },
    "compile": {
      "dependsOn": [
        "compile:crypto",
        "compile:security",
        "compile:utils",
        "compile:access",
        "compile:multisig",
        "compile:token"
      ],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["compile"],
      "env": ["COMPACT_HOME"],
      "outputs": [],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["compile"],
      "env": ["COMPACT_HOME"],
      "outputs": [],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["compile:integration"],
      "env": ["COMPACT_HOME"],
      "outputs": [],
      "cache": false
    },
    "test:harness": {
      "outputs": [],
      "cache": false
    },
    "test:scripts": {
      "outputs": [],
      "cache": false
    },
    "test:harness:live": {
      "dependsOn": ["test:harness"],
      "env": ["COMPACT_HOME"],
      "outputs": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["COMPACT_HOME"],
      "inputs": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "src/**/*.compact",
        "tsconfig.json",
        "tsconfig.build.json",
        ".env"
      ],
      "outputs": ["dist/**"]
    },
    "types": {
      "dependsOn": ["@openzeppelin/compact-contracts#compile"],
      "outputs": [],
      "cache": false
    },
    "//#lint": {},
    "//#lint:ci": {},
    "//#lint:fix": {
      "cache": false
    },
    "clean": {
      "outputs": [],
      "cache": false
    }
  }
}
