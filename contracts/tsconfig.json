{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "src/**/test/**/*.ts",
    "test-utils/**/*.ts"
  ],
  "exclude": ["src/archive/"],
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "declaration": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
  }
}
