// WARNING: FOR TESTING PURPOSES ONLY.
// This contract exposes internal circuits and bypasses safety checks that the
// corresponding production contract relies on. DO NOT deploy or use this
// contract in any production application.

pragma language_version >= 0.23.0;

import CompactStandardLibrary;

import "../../ShieldedAccessControl" prefix ShieldedAccessControl_;
import "../../Caller" prefix Caller_;
import "../../Principal" prefix Principal_;

export { MerkleTreePath,
         ShieldedAccessControl__operatorRoles,
         ShieldedAccessControl__roleCommitmentNullifiers,
         ShieldedAccessControl__adminRoles };

/**
 * @description The caller domain this deployment authenticates under. Stored at
 * deploy time so a principal can be derived off-chain before the contract exists,
 * which is what lets a deployment pre-grant a role to a named account.
 */
export ledger _callerDomain: Bytes<32>;

/**
 * @description `isInit` is a param for testing.
 *
 * If `isInit` is false, the constructor will not initialize the contract.
 * This behavior is to test that circuits are not callable unless the
 * contract is initialized.
*/
constructor(instanceSalt: Bytes<32>, isInit: Boolean, callerDomain: Bytes<32>) {
  _callerDomain = disclose(callerDomain);
  if (disclose(isInit)) {
    ShieldedAccessControl_initialize(instanceSalt);
  }
}

/**
 * @description Authenticates once, under this deployment's stored domain. Every
 * wrapper below routes through here. The circuit derives the principal and takes
 * none as a parameter, since a sender who could choose one would satisfy every role
 * gate in the contract.
 */
circuit authenticated(): Principal_AuthenticatedCaller {
  return Caller_authenticate(_callerDomain);
}

export pure circuit DEFAULT_ADMIN_ROLE(): ShieldedAccessControl_RoleIdentifier {
  return ShieldedAccessControl_DEFAULT_ADMIN_ROLE();
}

export circuit assertOnlyRole(role: ShieldedAccessControl_RoleIdentifier): [] {
  ShieldedAccessControl_assertOnlyRole(authenticated(), role);
}

export circuit canProveRole(role: ShieldedAccessControl_RoleIdentifier): Boolean {
  return ShieldedAccessControl_canProveRole(authenticated(), role);
}

export circuit grantRole(
                 role: ShieldedAccessControl_RoleIdentifier,
                 accountId: ShieldedAccessControl_AccountIdentifier
                 ): [] {
  ShieldedAccessControl_grantRole(authenticated(), role, accountId);
}

export circuit _grantRole(
                 role: ShieldedAccessControl_RoleIdentifier,
                 accountId: ShieldedAccessControl_AccountIdentifier
                 ): [] {
  return ShieldedAccessControl__grantRole(role, accountId);
}

export circuit renounceRole(
                 role: ShieldedAccessControl_RoleIdentifier,
                 accountIdConfirmation: ShieldedAccessControl_AccountIdentifier
                 ): [] {
  ShieldedAccessControl_renounceRole(authenticated(), role, accountIdConfirmation);
}

export circuit revokeRole(
                 role: ShieldedAccessControl_RoleIdentifier,
                 accountId: ShieldedAccessControl_AccountIdentifier
                 ): [] {
  ShieldedAccessControl_revokeRole(authenticated(), role, accountId);
}

export circuit _revokeRole(
                 role: ShieldedAccessControl_RoleIdentifier,
                 accountId: ShieldedAccessControl_AccountIdentifier
                 ): [] {
  return ShieldedAccessControl__revokeRole(role, accountId);
}

export circuit getRoleAdmin(
                 role: ShieldedAccessControl_RoleIdentifier
                 ): ShieldedAccessControl_RoleIdentifier {
  return ShieldedAccessControl_getRoleAdmin(role);
}

export circuit _setRoleAdmin(
                 role: ShieldedAccessControl_RoleIdentifier,
                 adminRole: ShieldedAccessControl_RoleIdentifier
                 ): [] {
  ShieldedAccessControl__setRoleAdmin(role, adminRole);
}

export circuit computeRoleCommitment(
                 role: ShieldedAccessControl_RoleIdentifier,
                 accountId: ShieldedAccessControl_AccountIdentifier
                 ): ShieldedAccessControl_RoleCommitment {

  return ShieldedAccessControl_computeRoleCommitment(role, accountId);
}

export pure circuit computeNullifier(
                      roleCommitment: ShieldedAccessControl_RoleCommitment
                      ): ShieldedAccessControl_RoleNullifier {
  return ShieldedAccessControl_computeNullifier(roleCommitment);
}
