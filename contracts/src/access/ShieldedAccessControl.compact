// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.5.0-alpha.2 (access/ShieldedAccessControl.compact)

pragma language_version >= 0.28.0;

/**
 * @module ShieldedAccessControl
 * @description A Shielded AccessControl library.
 *
 * This module provides a shielded role-based access control (RBAC) mechanism, where roles can be used to
 * represent a set of permissions. Roles are stored as Merkle tree commitments to avoid
 * disclosing information about role holders. Role commitments are created with the following
 * hashing scheme, where `‖` denotes concatenation and all values are `Bytes<32>`:
 *
 * ```
 * roleCommitment := SHA256( role ‖ accountCommitment ‖ instanceSalt ‖ commitmentDomain ) where
 *
 * accountCommitment := persistentCommit( { accountDomain, account }, blinding )
 *
 * roleNullifier  := SHA256( roleCommitment ‖ nullifierDomain )
 *
 * account          := the `left` of the caller's account (see `Identifier`)
 * accountDomain    := pad(32, "ShieldedAccessControl:account")
 * commitmentDomain := pad(32, "ShieldedAccessControl:commitment")
 * nullifierDomain  := pad(32, "ShieldedAccessControl:nullifier")
 * ```
 *
 *  - `roleCommitment` is a Merkle tree leaf committing a `(roleId, accountCommitment)` pairing, inserted
 *     into `_operatorRoles` on grant. The `instanceSalt` prevents commitment collisions across
 *     deployments that share the same role identifiers.
 *  - `accountCommitment` hides the role holder's account under a `blinding` the holder keeps secret,
 *     so the account itself may be public. The holder computes it off-chain with {computeAccountCommitment}
 *     and gives it to the admin. It does not bind the contract instance: the same account and blinding
 *     in two instances give both admins the same value. This module derives no caller. Every
 *     authenticating circuit takes a `Caller`, see `Caller` in the `Identifier` module.
 *     The caller must be a key caller: a contract caller is rejected. A zero account and a zero
 *     blinding are rejected. One `accountCommitment` can hold several roles within the same contract
 *     instance.
 *  - `roleNullifier` is a one-time burn token inserted into `_roleCommitmentNullifiers` on
 *     revocation. Its presence permanently invalidates the corresponding role commitment,
 *     making re-grant under the same `accountCommitment` impossible.
 *  - `instanceSalt` should be an immutable, cryptographically strong random value provided on deployment
 *  - `accountDomain` is the following zero padded 32 byte string: "ShieldedAccessControl:account"
 *  - `commitmentDomain` is the following zero padded 32 byte string: "ShieldedAccessControl:commitment"
 *  - `nullifierDomain` is the following zero padded 32 byte string: "ShieldedAccessControl:nullifier"
 *
 * In this RBAC model, role commitments behave like private bearer tokens. Possession of a valid, non-revoked role
 * commitment grants authorization. Revocation permanently burns the role instance, requiring explicit new issuance
 * under a new account commitment. This creates stronger security invariants over traditional RBAC systems and
 * enables privacy-preserving identity rotation.
 *
 * A single `accountCommitment` may hold all of a holder's roles within a contract instance. This is safe because the
 * `role` identifier is mixed into the commitment (not the `accountCommitment`), so different roles produce
 * different commitments and different nullifiers even when the underlying `accountCommitment` is the same.
 * Revoking one role does not affect other roles held by the same `accountCommitment`.
 *
 * A revoked pairing cannot be re-granted. To be re-authorized the holder draws a new blinding, which gives a
 * new `accountCommitment`. Roles still held under the old commitment need the old blinding: the holder supplies
 * the matching one per call, or has them re-granted under the new commitment.
 *
 * Roles are referred to by their `Bytes<32>` identifier. These should be exposed
 * in the top-level contract and be unique. One way to achieve this is by
 * using `export sealed ledger` hash digests that are initialized in the top-level contract:
 *
 * ```compact
 * import CompactStandardLibrary;
 *
 * import { IdentifierCommitment } from "./node_modules/@openzeppelin/compact-contracts/src/identifier/extensions/IdentifierCommitment";
 *
 * import "./node_modules/@openzeppelin/compact-contracts/src/access/ShieldedAccessControl" prefix ShieldedAccessControl_;
 *
 * export sealed ledger MY_ROLE: Bytes<32>;
 *
 * constructor(instanceSalt: Bytes<32>, defaultAdmin: IdentifierCommitment) {
 *  MY_ROLE = persistentHash<Bytes<32>>(pad(32, "MY_ROLE"));
 *  ShieldedAccessControl_initialize(instanceSalt);
 *  ShieldedAccessControl__grantRole(ShieldedAccessControl_DEFAULT_ADMIN_ROLE(), defaultAdmin);
 * }
 * ```
 *
 * To restrict access to a circuit, use {assertOnlyRole}:
 *
 * ```compact
 * circuit foo(): [] {
 *  const caller = AuthPrfPseudonym_authenticate(_callerSalt);
 *  ShieldedAccessControl_assertOnlyRole(caller, RandBlinding_read(), MY_ROLE as ShieldedAccessControl_RoleIdentifier);
 *  // ... rest of circuit logic
 * }
 * ```
 *
 * Roles can be granted and revoked dynamically via the {grantRole} and
 * {revokeRole} circuits. Each role has an associated admin role, and only
 * accounts that have a role's admin role can call {grantRole} and {revokeRole}.
 *
 * By default, the admin role for all roles is `DEFAULT_ADMIN_ROLE`, which means
 * that only accounts with this role will be able to grant or revoke other
 * roles. More complex role relationships can be created by using
 * {_setRoleAdmin}.
 *
 * WARNING: The `DEFAULT_ADMIN_ROLE` is also its own admin: it has permission to
 * grant and revoke this role. Extra precautions should be taken to secure
 * accounts that have been granted it.
 *
 * @dev Privacy Assumptions
 * - Outside observers will know when an admin is added and how many admins exist.
 * - Outside observers will know which role identifiers are admin identifiers.
 * - Outside observers will have knowledge of all role identifiers.
 * - Role commitments inserted into the `_operatorRoles` MerkleTree are NOT visible in the
 *   public proof transcript. The MerkleTree insert hashes the value internally, and only
 *   the internal leaf hash is declared as a public input. Observers cannot recover the
 *   commitment from the leaf hash. This is in contrast to Set operations, where values
 *   are directly visible in the proof transcript.
 * - Because commitments are hidden, outside observers will have knowledge of all role
 *   nullifiers but cannot link them to their corresponding commitments unless the
 *   commitment value space is small enough to enumerate. The strength of this unlinkability
 *   depends on the number of plausible `(role, accountCommitment)` pairings. Since role identifiers
 *   are public, the anonymity set is effectively the number of plausible account commitments per role.
 * - Outside observers will know when roles are granted and revoked.
 * - Outside observers can infer the total number of distinct `(role, accountCommitment)` pairings granted
 *   across all roles, not per-role counts.
 * - Outside observers can link calls made by the same role instance across time.
 * - Users can be retroactively deanonymized if their blinding is exposed.
 * - Outside observers will NOT be able to identify the holder of any role
 *   so long as blinding values are kept secret and generated using cryptographically
 *   secure random values, even when the holder's account is public.
 * - A circuit that proves a role and also writes the caller's account publishes the role
 *   nullifier and the account in one transaction. The blinding does not hide that link.
 * - Outside observers can correlate grant and revocation transactions for the same
 *   `(role, accountCommitment)` pairing by matching nullifier values. During a grant, the nullifier
 *   is disclosed via the `_roleCommitmentNullifiers.member` check. During a revocation, the
 *   same nullifier is disclosed via `_roleCommitmentNullifiers.insert`. This allows an observer
 *   to determine that a specific grant and revocation are related, but does not reveal the
 *   identity of the role holder or the commitment value.
 * - Role holders have a stable pseudonymous on-chain identity for the lifetime of their role
 *   commitment. Every call to a protected circuit (`assertOnlyRole`, `canProveRole`) discloses
 *   the same nullifier via the `_roleCommitmentNullifiers.member` check, enabling observers to
 *   link all actions performed under the same role instance. This provides pseudonymity, not anonymity.
 *
 * @dev Security Considerations:
 * - Credential requirements are documented in the authenticator the contract composes. Proving
 *   a role needs both the key behind the account and the blinding. Loss of either prevents role
 *   holders and admins from proving access.
 * - Role checks trust the `caller` they are given. Produce it with an authenticator
 *   inside the composing circuit. An exported circuit that accepts a caller lets the
 *   transaction sender choose who passes the check.
 * - It's strongly recommended to use cryptographically secure random values for the `_instanceSalt`.
 *   Failure to do so may weaken privacy guarantees.
 * - The `_instanceSalt` is immutable and used to differentiate deployments.
 * - The `_operatorRoles` Merkle tree has a fixed capacity of 2^20 leaf slots. Each distinct
 *   `(role, accountCommitment)` pairing consumes one slot; re-granting an active pairing is a no-op.
 * - A leaked blinding links all roles held under that `accountCommitment` within the contract
 *   instance. Users requiring compartmentalization between roles should use a separate blinding
 *   per role and accept the additional management overhead.
 *   In the event of a compromise, the user should coordinate with admins to revoke all roles
 *   under the compromised `accountCommitment` and re-grant under a new one.
 * - Admins can revoke `(role, accountCommitment)` pairings that were never granted, since on-chain
 *   non-membership proofs are not available for the Merkle tree. This permanently burns the
 *   nullifier for that pairing, blocking any future grant. Admin trust is a fundamental
 *   assumption of this system. Off-chain validation should confirm that a pairing was actually
 *   granted before submitting a revocation transaction.
 * - `renounceRole` allows burning nullifiers for roles the caller does not currently hold,
 *   provided they prove that `accountCommitment`. This requires both the key behind the account and
 *   the blinding, at which point the `accountCommitment` should be considered fully compromised regardless.
 * - The Merkle tree capacity of 2^20 leaf slots is a permanent, irrecoverable resource.
 *   There is no mechanism to reclaim slots after revocation, no upgrade path, and no emergency
 *   recovery. Once exhausted, the contract is permanently unable to grant new roles. Deployers
 *   must monitor slot consumption off-chain and plan capacity accordingly. The exported tree
 *   reports occupancy via `firstFree()` (TypeScript) and `isFull()` (circuit).
 *
 * @notice Using the SHA256 hashing function comes at a significant performance cost. In the future, we
 * plan on migrating to a ZK-friendly hashing function when an implementation is available.
 *
 * @notice Missing Features and Improvements:
 * - Role events
 * - An ERC165-like interface
 * - Migrate from SHA256 to a ZK-friendly hashing function when an implementation is available.
 */
module ShieldedAccessControl {
  import CompactStandardLibrary;

  import { Caller, IdentifierKind } from "../identifier/Identifier";
  import { IdentifierCommitment } from "../identifier/extensions/IdentifierCommitment";
  import { Blinding } from "../crypto/randomness/RandBlinding";

  import "../identifier/Identifier" prefix Identifier_;
  import "../identifier/extensions/IdentifierCommitment" prefix IdentifierCommitment_;
  import "../utils/Utils" prefix Utils_;

  /**
   * @description The kind of a role update: `Grant` or `Revoke`.
   */
  export enum UpdateType {
    Grant,
    Revoke
  };

  // TODO: Standardize types across contracts https://github.com/OpenZeppelin/compact-contracts/issues/368
  /**
   * A role commitment, `SHA256(role | accountCommitment | instanceSalt |
   * commitmentDomain)`, stored as a leaf of `_operatorRoles`.
   */
  export new type RoleCommitment = Bytes<32>;
  /**
   * A role identifier. `DEFAULT_ADMIN_ROLE` is all zero bytes.
   */
  export new type RoleIdentifier = Bytes<32>;
  /**
   * A role nullifier, `SHA256(roleCommitment | nullifierDomain)`.
   */
  export new type RoleNullifier = Bytes<32>;

  /**
   * @description Initialization flag, tracked per-module to avoid the compiler's
   * shared transitive-dependency state bug (LFDT-Minokawa/compact#270). See the
   * Initializable module for rationale.
   */
  export ledger _isInitialized: Boolean;

  /**
   * @ledger _operatorRoles
   * @description A Merkle tree of role commitments stored as SHA256(role | accountCommitment | instanceSalt | commitmentDomain)
   * Role commitments are derived from a public role identifier (e.g., `persistentHash<Bytes<32>>(pad(32, "MY_ROLE")`),
   * the holder's account commitment, the `instanceSalt`, and a domain separator.
   * @type {RoleCommitment} roleCommitment - A role commitment created by the following hash: SHA256( role | accountCommitment | instanceSalt | commitmentDomain).
   */
  export ledger _operatorRoles: MerkleTree<20, RoleCommitment>;

  /**
   * @ledger _adminRoles
   * @description Mapping from a role identifier to an admin role identifier.
   * @type {RoleIdentifier} role - The role being administered.
   * @type {RoleIdentifier} adminRole - The role permitted to grant and revoke it.
   * @type {Map<role, adminRole>}
   * @type {Map<RoleIdentifier, RoleIdentifier>} _adminRoles
   */
  export ledger _adminRoles: Map<RoleIdentifier, RoleIdentifier>;

  /**
   * @description A set of nullifiers used to prove a role has been revoked
   * @type {RoleNullifier} roleNullifier - A role nullifier created by the following hash: SHA256(roleCommitment | nullifierDomain).
   * @type {Set<RoleNullifier>} _roleCommitmentNullifiers
   */
  export ledger _roleCommitmentNullifiers: Set<RoleNullifier>;

  /**
   * @description Nullifiers of every pairing ever granted. Makes a repeated grant a no-op so
   * one pairing can never consume more than one `_operatorRoles` slot.
   * @type {Set<RoleNullifier>} _grantedRoleNullifiers
   */
  export ledger _grantedRoleNullifiers: Set<RoleNullifier>;

  /**
   * @sealed @ledger _instanceSalt
   * @description A per-instance value provided at initialization used to namespace
   * commitments for this contract instance.
   *
   * This salt prevents commitment collisions across contracts that might otherwise use
   * the same identifiers or domain parameters. It should be a cryptographically strong random value.
   * If two deployments share the same instanceSalt and a user holds the same account and blinding in both,
   * all role commitments will be identical in both contracts.
   * An observer who sees the same nullifier appear in both contracts' nullifier sets can conclude
   * that it's the same user.
   * It is immutable after initialization.
   */
  export sealed ledger _instanceSalt: Bytes<32>;

  /**
   * @witness wit_getRoleCommitmentPath
   * @description Returns a path to a role commitment in the `_operatorRoles` Merkle tree if one exists. Otherwise, returns an invalid path.
   *
   * @param {RoleCommitment} roleCommitment - A commitment created by the following hash: SHA256( role | accountCommitment | instanceSalt | commitmentDomain).
   *
   * @returns {MerkleTreePath<20, RoleCommitment>} - The Merkle tree path to `roleCommitment` in the `_operatorRoles` Merkle tree
   */
  witness wit_getRoleCommitmentPath(
            roleCommitment: RoleCommitment
            ): MerkleTreePath<20, RoleCommitment>;

  /**
   * @description Initializes the contract by storing the `instanceSalt` that acts as a privacy additive
   * for preventing duplicate commitments among other contracts implementing ShieldedAccessControl.
   *
   * @constraints k=8, rows=155
   *
   * @warning The `instanceSalt` must be calculated prior to contract deployment using a cryptographically
   * secure random number generator e.g. crypto.getRandomValues() to maintain strong privacy guarantees
   *
   * Requirements:
   *
   * - Contract is not initialized.
   *
   * @param {Bytes<32>} instanceSalt - Contract salt to prevent duplicate commitments if
   * one account is used in different contracts. Must not be zero.
   *
   * @returns {[]} Empty tuple.
   */
  export circuit initialize(instanceSalt: Bytes<32>): [] {
    assert(instanceSalt != default<Bytes<32>>, "ShieldedAccessControl: Instance salt must not be 0");
    assertNotInitialized();
    _isInitialized = true;

    _instanceSalt = disclose(instanceSalt);
  }

  /**
   * @description Asserts that the contract has been initialized, throwing an error if not.
   *
   * Requirements:
   *
   * - Contract must be initialized.
   *
   * @returns {[]} - Empty tuple.
   */
  circuit assertInitialized(): [] {
    assert(_isInitialized, "ShieldedAccessControl: contract not initialized");
  }

  /**
   * @description Asserts that the contract has not been initialized, throwing an error if it has.
   *
   * Requirements:
   *
   * - Contract must not be initialized.
   *
   * @returns {[]} - Empty tuple.
   */
  circuit assertNotInitialized(): [] {
    assert(!_isInitialized, "ShieldedAccessControl: contract already initialized");
  }

  /**
   * @description The default admin role for all roles. Only accounts with this role will be able to grant or revoke other roles
   * unless custom admin roles are created.
   *
   * @remarks The Compact language does not support constant declarations,
   * so DEFAULT_ADMIN_ROLE is implemented as a circuit that returns a constant value by necessity.
   */
  export pure circuit DEFAULT_ADMIN_ROLE(): RoleIdentifier {
    return default<Bytes<32>> as RoleIdentifier;
  }

  /**
   * @description Reverts if `caller` cannot provide a valid proof of ownership for `role`.
   *
   * @constraints k=14, rows=16075
   *
   * Requirements:
   *
   * - `caller` must prove ownership of `role` under `blinding`.
   * - caller must not provide valid Merkle tree path for a different `(role, accountCommitment)` pairing.
   * - `caller` is not the zero account.
   * - `blinding` is not zero.
   * - Contract is initialized.
   *
   * Disclosures:
   *
   * - A Merkle tree path to a role commitment.
   * - A role commitment corresponding to a `(role, accountCommitment)` pairing.
   * - A nullifier for the respective role commitment.
   *
   * @param {Caller} caller - The authenticated caller.
   * @param {Bytes<32>} blinding - The caller's blinding factor.
   * @param {RoleIdentifier} role - The role identifier.
   *
   * @returns {[]} - Empty tuple.
   */
  export circuit assertOnlyRole(caller: Caller, blinding: Blinding, role: RoleIdentifier): [] {
    assertInitialized();
    assert(_uncheckedCanProveRole(caller, blinding, role),
           "ShieldedAccessControl: unauthorized account"
           );
  }

  /**
   * @description Returns `true` if `caller` proves ownership of `role` and is not revoked. MAY return false for a legitimately credentialed
   * caller if the proving environment supplies an invalid Merkle path. This circuit will never return true for an
   * unauthorized caller.
   *
   * @constraints k=14, rows=16095
   *
   * Requirements:
   *
   * - caller must not provide valid Merkle tree path for a different `(role, accountCommitment)` pairing.
   * - `caller` is not the zero account.
   * - `blinding` is not zero.
   * - Contract is initialized.
   *
   * Disclosures:
   *
   * - A Merkle tree path to a role commitment.
   * - A role commitment corresponding to a `(role, accountCommitment)` pairing.
   * - A nullifier for the respective role commitment.
   *
   * @param {Caller} caller - The authenticated caller.
   * @param {Bytes<32>} blinding - The caller's blinding factor.
   * @param {RoleIdentifier} role - The role identifier.
   *
   * @returns {Boolean} - A boolean determining if a caller successfully proved ownership of `role`
   */
  export circuit canProveRole(caller: Caller, blinding: Blinding, role: RoleIdentifier): Boolean {
    assertInitialized();
    return _uncheckedCanProveRole(caller, blinding, role);
  }

  /**
   * @description Returns `true` if `caller` proves ownership of `role` and is not revoked. MAY return false for a legitimately credentialed
   * caller if the proving environment supplies an invalid Merkle path. This circuit will never return true for an
   * unauthorized caller.
   *
   * @warning This circuit does not perform an initialization check. It's only meant to be used as
   * an internal helper in the Shielded Access Control module. Using this circuit outside of the
   * module may cause undefined behavior and break security guarantees.
   *
   * Requirements:
   *
   * - caller must not provide valid Merkle tree path for a different `(role, accountCommitment)` pairing.
   * - `caller` is not the zero account.
   * - `blinding` is not zero.
   *
   * Disclosures:
   *
   * - A Merkle tree path to a role commitment.
   * - A role commitment corresponding to a `(role, accountCommitment)` pairing.
   * - A nullifier for the respective role commitment.
   *
   * @param {Caller} caller - The authenticated caller.
   * @param {Bytes<32>} blinding - The caller's blinding factor.
   * @param {RoleIdentifier} role - The role identifier.
   *
   * @returns {Boolean} - A boolean determining if a caller successfully proved ownership of `role`
   */
  circuit _uncheckedCanProveRole(caller: Caller, blinding: Blinding, role: RoleIdentifier): Boolean {
    return _validateRole(role, _computeAccountCommitment(caller, blinding));
  }

  /**
   * @description Grants `role` to `accountCommitment` by inserting a role commitment unique to the
   * `(role, accountCommitment)` pairing into the `_operatorRoles` Merkle tree. Granting an already active
   * pairing is a no-op. Once revoked, a role cannot be re-granted to the same `accountCommitment`. A new
   * `accountCommitment` must be generated to be re-authorized for a revoked `role`.
   *
   * @constraints k=15, rows=27563
   *
   * Requirements:
   *
   * - caller must prove they're an admin for `role` under `blinding`.
   * - caller must not provide valid Merkle tree path for a different `(role, accountCommitment)` pairing.
   * - The `(role, accountCommitment)` pairing must not be already revoked.
   * - `caller` is not the zero account.
   * - `blinding` is not zero.
   * - Contract is initialized.
   *
   * Disclosures:
   *
   * - A Merkle tree path to a role commitment.
   * - A role commitment corresponding to a `(role, accountCommitment)` pairing.
   * - A nullifier for the respective role commitment.
   * - A role identifier.
   *
   * @param {Caller} caller - The authenticated caller.
   * @param {Bytes<32>} blinding - The caller's blinding factor.
   * @param {RoleIdentifier} role - The role identifier.
   * @param {IdentifierCommitment} accountCommitment - The holder's account commitment, computed off-chain by the
   * grantee with {computeAccountCommitment}.
   *
   * @returns {[]} - Empty tuple.
   */
  export circuit grantRole(
                   caller: Caller,
                   blinding: Blinding,
                   role: RoleIdentifier,
                   accountCommitment: IdentifierCommitment
                   ): [] {
    // Initialization check performed in assertOnlyRole
    assertOnlyRole(caller, blinding, getRoleAdmin(role));
    _updateRole(role, accountCommitment, UpdateType.Grant);
  }

  /**
   * @description Grants `role` to `accountCommitment` by inserting a role commitment unique to the
   * `(role, accountCommitment)` pairing into the `_operatorRoles` Merkle tree. Granting an already active
   * pairing is a no-op. Once revoked, a role cannot be re-granted to the same `accountCommitment`. A new
   * `accountCommitment` must be generated to be re-authorized for a revoked `role`.
   *
   * Internal circuit without access restriction.
   *
   * @warning Exposing this circuit directly in an implementing contract would allow anyone to grant
   * roles without authorization. It must be wrapped with appropriate access control.
   *
   * @warning The `_operatorRoles` Merkle tree has a fixed capacity of 2^20 leaf slots, one per
   * distinct pairing. Deployers should monitor slot consumption off-chain.
   *
   * @constraints k=14, rows=11573
   *
   * Requirements:
   *
   * - The `(role, accountCommitment)` pairing must not be already revoked.
   * - Contract is initialized.
   *
   * Disclosures:
   *
   * - A role commitment corresponding to a `(role, accountCommitment)` pairing.
   * - A nullifier for the respective role commitment.
   *
   * @param {RoleIdentifier} role - The role identifier.
   * @param {IdentifierCommitment} accountCommitment - The account commitment.
   *
   * @returns {[]} - Empty tuple.
   */
  export circuit _grantRole(role: RoleIdentifier, accountCommitment: IdentifierCommitment): [] {
    assertInitialized();
    _updateRole(role, accountCommitment, UpdateType.Grant);
  }

  /**
   * @description Revokes `role` from the calling account by inserting a role nullifier into the
   * `_roleCommitmentNullifiers` set. Once revoked, a new `accountCommitment` must be generated to be
   * re-authorized for `role`.
   *
   * @notice Roles are often managed via {grantRole} and {revokeRole}: this circuit's
   * purpose is to provide a mechanism for accounts to lose their privileges
   * if they are compromised (such as when a trusted device is misplaced).
   *
   * @warning Outside observers may be able to use timing and pattern analysis to weaken pseudonymity
   * guarantees if renounceRole is used in tandem with other on-chain actions.
   *
   * @constraints k=14, rows=13700
   *
   * Requirements:
   *
   * - `caller` must not be a contract.
   * - `accountCommitmentConfirmation` must match the account commitment computed from `caller` and `blinding`.
   * - The `(role, accountCommitment)` pairing must not be already revoked.
   * - `caller` is not the zero account.
   * - `blinding` is not zero.
   * - Contract is initialized.
   *
   * Disclosures:
   *
   * - A nullifier for the respective role commitment.
   *
   * @param {Caller} caller - The authenticated caller.
   * @param {Bytes<32>} blinding - The caller's blinding factor.
   * @param {RoleIdentifier} role - The role identifier.
   * @param {IdentifierCommitment} accountCommitmentConfirmation - The caller's account commitment, must match the one computed from `caller` and `blinding`.
   *
   * @returns {[]} - Empty tuple.
   */
  export circuit renounceRole(
                   caller: Caller,
                   blinding: Blinding,
                   role: RoleIdentifier,
                   accountCommitmentConfirmation: IdentifierCommitment
                   ): [] {
    assertInitialized();

    assert(accountCommitmentConfirmation == _computeAccountCommitment(caller, blinding),
           "ShieldedAccessControl: bad confirmation"
           );

    _updateRole(role, accountCommitmentConfirmation, UpdateType.Revoke);
  }

  /**
   * @description Permanently revokes `role` from `accountCommitment` by inserting a role nullifier into the
   * `_roleCommitmentNullifiers` set. Once revoked, a new `accountCommitment` must be generated to be re-authorized for
   * `role`. At this time, proofs of non-membership on values in the Merkle tree LDT are not possible
   * so a `(role, accountCommitment)` pairing that does not exist can still be revoked.
   *
   * @constraints k=15, rows=25628
   *
   * Requirements:
   *
   * - caller must prove they're an admin for `role` under `blinding`.
   * - caller must not provide valid Merkle tree path for a different `(role, accountCommitment)` pairing.
   * - The `(role, accountCommitment)` pairing must not be already revoked.
   * - `caller` is not the zero account.
   * - `blinding` is not zero.
   * - Contract is initialized.
   *
   * Disclosures:
   *
   * - A Merkle tree path to a role commitment.
   * - A role commitment corresponding to a `(role, accountCommitment)` pairing.
   * - A nullifier for the respective role commitment.
   * - A role identifier.
   *
   * @param {Caller} caller - The authenticated caller.
   * @param {Bytes<32>} blinding - The caller's blinding factor.
   * @param {RoleIdentifier} role - The role identifier.
   * @param {IdentifierCommitment} accountCommitment - The holder's account commitment, computed off-chain by the
   * grantee with {computeAccountCommitment}.
   *
   * @returns {[]} - Empty tuple.
   */
  export circuit revokeRole(
                   caller: Caller,
                   blinding: Blinding,
                   role: RoleIdentifier,
                   accountCommitment: IdentifierCommitment
                   ): [] {
    // Initialization check performed in assertOnlyRole
    assertOnlyRole(caller, blinding, getRoleAdmin(role));
    _updateRole(role, accountCommitment, UpdateType.Revoke);
  }

  /**
   * @description Permanently revokes `role` from `accountCommitment` by inserting a role nullifier into the
   * `_roleCommitmentNullifiers` set. Once revoked, a new `accountCommitment` must be generated to be re-authorized for
   * `role`. At this time, proofs of non-membership on values in the Merkle tree LDT are not possible
   * so a `(role, accountCommitment)` pairing that does not exist can still be revoked.
   *
   * Internal circuit without access restriction.
   *
   * @warning Exposing this circuit directly in an implementing contract would allow anyone to revoke
   * roles without authorization. It must be wrapped with appropriate access control.
   *
   * @constraints k=14, rows=9638
   *
   * Requirements:
   *
   * - The `(role, accountCommitment)` pairing must not be already revoked.
   * - Contract is initialized.
   *
   * Disclosures:
   *
   * - A nullifier for the respective role commitment.
   *
   * @param {RoleIdentifier} role - The role identifier.
   * @param {IdentifierCommitment} accountCommitment - The account commitment.
   *
   * @returns {[]} - Empty tuple.
   */
  export circuit _revokeRole(role: RoleIdentifier, accountCommitment: IdentifierCommitment): [] {
    assertInitialized();
    _updateRole(role, accountCommitment, UpdateType.Revoke);
  }

  /**
   * @description Core business logic for the grant/revoke role circuits. Asserts that the
   * `(role, accountCommitment)` pairing has not already been revoked. On success, dispatches on
   * `updateType`: a `Grant` inserts the role commitment into `_operatorRoles` unless the
   * nullifier is already in `_grantedRoleNullifiers`, and a `Revoke` inserts the nullifier
   * into `_roleCommitmentNullifiers`.
   *
   * Disclosures:
   *
   * - A nullifier for the respective role commitment.
   * - A role commitment (on first Grant only).
   *
   * @notice The nullifier is disclosed via `_roleCommitmentNullifiers.member` on every call,
   * regardless of the update type. Since `Set.member` publicly reveals its argument, the
   * nullifier value is observable in the transaction transcript. This enables observers to
   * correlate grant and revocation transactions for the same `(role, accountCommitment)` pairing.
   *
   * @param {RoleIdentifier} role - The role identifier.
   * @param {IdentifierCommitment} accountCommitment - The account commitment.
   * @param {UpdateType} updateType - Whether to grant or revoke.
   *
   * @returns {[]} - Empty tuple.
   */
  circuit _updateRole(
            role: RoleIdentifier,
            accountCommitment: IdentifierCommitment,
            updateType: UpdateType
            ): [] {
    const roleCommitment = computeRoleCommitment(role, accountCommitment);
    const roleNullifier = computeNullifier(roleCommitment);
    const isRevoked = _roleCommitmentNullifiers.member(disclose(roleNullifier));
    assert(!isRevoked, "ShieldedAccessControl: role is already revoked");

    if (updateType == UpdateType.Grant) {
      if (!_grantedRoleNullifiers.member(disclose(roleNullifier))) {
        _grantedRoleNullifiers.insert(disclose(roleNullifier));
        _operatorRoles.insert(disclose(roleCommitment));
      }
    } else {
      _roleCommitmentNullifiers.insert(disclose(roleNullifier));
    }
  }

  /**
   * @description Returns the admin role that controls `role`. Returns `DEFAULT_ADMIN_ROLE` for
   * roles with no explicitly set admin. Since `DEFAULT_ADMIN_ROLE` is the zero byte array,
   * there is no distinction between a nonexistent `role` and one whose admin is `DEFAULT_ADMIN_ROLE`.
   * See {grantRole} and {revokeRole}.
   *
   * To change a role's admin use {_setRoleAdmin}.
   *
   * @constraints k=8, rows=170
   *
   * Disclosures:
   *
   * - A role identifier.
   *
   * @param {RoleIdentifier} role - The role identifier.
   *
   * @returns {RoleIdentifier} roleAdmin - The admin role that controls `role`.
   */
  export circuit getRoleAdmin(role: RoleIdentifier): RoleIdentifier {
    if (_adminRoles.member(disclose(role))) {
      return _adminRoles.lookup(disclose(role));
    }
    return DEFAULT_ADMIN_ROLE();
  }

  /**
   * @description Sets `adminId` as `role`'s admin identifier. Users with valid admin identifiers
   * may grant and revoke access to the specified `role`. Internal circuit without access restriction.
   *
   * @warning Exposing this circuit directly in an implementing contract would allow anyone to assign
   * arbitrary admin roles without authorization. It must be wrapped with appropriate access control.
   *
   * @constraints k=8, rows=228
   *
   * Disclosures:
   *
   * - The role identifier
   * - The admin identifier
   *
   * @param {RoleIdentifier} role - The role identifier.
   * @param {RoleIdentifier} adminId - The admin identifier for `role`.
   *
   * @returns {[]} - Empty tuple.
   */
  export circuit _setRoleAdmin(role: RoleIdentifier, adminId: RoleIdentifier): [] {
    assertInitialized();
    _adminRoles.insert(disclose(role), disclose(adminId));
  }

  /**
   * @description Verifies whether `accountCommitment` holds `role`. This circuit MAY return false for a
   * legitimately credentialed account if the proving environment supplies an invalid Merkle path.
   *
   * @warning This circuit does not perform an initialization check. It's only meant to be used as
   * an internal helper in the Shielded Access Control module. Using this circuit outside of the
   * module may cause undefined behavior and break security guarantees.
   *
   * Requirements:
   *
   * - caller must not provide valid Merkle tree path for a different `(role, accountCommitment)` pairing.
   *
   * Disclosures:
   *
   * - A Merkle tree path to a role commitment.
   * - A nullifier for the respective role commitment.
   *
   * @notice The nullifier is disclosed via `_roleCommitmentNullifiers.member` on every call.
   * Since this circuit is invoked by `assertOnlyRole` and `canProveRole`, every protected
   * operation discloses the same nullifier, allowing observers to link all actions performed
   * under the same role instance across time.
   *
   * @param {RoleIdentifier} role - The role identifier.
   * @param {IdentifierCommitment} accountCommitment - The account commitment.
   *
   * @returns {Boolean} isValidRole - A boolean indicating whether `accountCommitment` has a valid role
   */
  circuit _validateRole(role: RoleIdentifier, accountCommitment: IdentifierCommitment): Boolean {
    const roleCommitment = computeRoleCommitment(role, accountCommitment);
    const roleCommitmentPath = wit_getRoleCommitmentPath(roleCommitment);
    const isValidPath =
            _operatorRoles.checkRoot(
              merkleTreePathRoot<20, RoleCommitment>(disclose(roleCommitmentPath))
              );

    // If the path is valid we assert it's a path for the queried leaf (not some other leaf).
    if (isValidPath) {
      assert(roleCommitmentPath.leaf == roleCommitment,
             "ShieldedAccessControl: Path must contain leaf matching computed role commitment for the provided role, accountCommitment pairing"
             );
    }

    const roleNullifier = computeNullifier(roleCommitment);
    const isRevoked = _roleCommitmentNullifiers.member(disclose(roleNullifier));

    return isValidPath && !isRevoked;
  }

  /**
   * @description Computes the role commitment from the given `accountCommitment` and `role`.
   *
   * @warning This circuit does not perform an initialization check. It's only meant to be used as
   * an internal helper in the Shielded Access Control module. Using this circuit outside of the
   * module may cause undefined behavior and break security guarantees.
   *
   * ## Account commitment (`accountCommitment`)
   * The `accountCommitment` hides the holder's account under their blinding. See {computeAccountCommitment}.
   *
   * ## Role Commitment Derivation
   * `roleCommitment = SHA256(role, accountCommitment, instanceSalt, commitmentDomain)`
   *
   * - `accountCommitment`: See above.
   * - `role`: A unique role identifier.
   * - `instanceSalt`: A unique per-deployment salt, stored during initialization.
   * This prevents commitment collisions across deployments.
   * - `commitmentDomain`: Domain separator `"ShieldedAccessControl:commitment"` (padded to 32 bytes) to prevent
   * hash collisions when extending the module or using similar commitment schemes.
   *
   * @constraints k=13, rows=5866
   *
   * @param {RoleIdentifier} role - The role identifier.
   * @param {IdentifierCommitment} accountCommitment - The account commitment.
   *
   * @returns {RoleCommitment} The commitment derived from `accountCommitment` and `role`.
   */
  export circuit computeRoleCommitment(
                   role: RoleIdentifier,
                   accountCommitment: IdentifierCommitment,
                   ): RoleCommitment {

    return persistentHash<Vector<4, Bytes<32>>>(
             [role as Bytes<32>,
              accountCommitment as Bytes<32>,
              _instanceSalt,
              pad(32, "ShieldedAccessControl:commitment")]
             )
           as RoleCommitment;
  }

  /**
   * @description Computes the role nullifier for a given `roleCommitment`.
   *
   * ## Role Nullifier Derivation
   * `roleNullifier = SHA256(roleCommitment, nullifierDomain)`
   *
   * - `roleCommitment`: See `computeRoleCommitment`.
   * - `nullifierDomain`: Domain separator `"ShieldedAccessControl:nullifier"` (padded to 32 bytes) to prevent
   * hash collisions when extending the module or using similar commitment schemes.
   *
   * @param {RoleCommitment} roleCommitment - The role commitment for a particular `(role, accountCommitment)` pairing.
   *
   * @returns {RoleNullifier} roleNullifier - The associated nullifier for `roleCommitment`.
   */
  export pure circuit computeNullifier(roleCommitment: RoleCommitment): RoleNullifier {
    return persistentHash<Vector<2, Bytes<32>>>(
             [roleCommitment as Bytes<32>, pad(32, "ShieldedAccessControl:nullifier")]
             )
           as RoleNullifier;
  }

  /**
   * @description Computes the `accountCommitment` of `caller` from their account and their blinding factor.
   *
   * ## Derivation
   * `persistentCommit` over `{accountDomain, account}` with `blinding`, where `accountDomain` is
   * `"ShieldedAccessControl:account"` (padded to 32 bytes).
   *
   * - `account`: The `left` of the caller's account, a `Bytes<32>`. A contract caller is rejected.
   * - `blinding`: The caller's secret blinding factor, a `Bytes<32>`.
   *
   * Requirements:
   *
   * - `caller` is not the zero account.
   * - `blinding` is not zero.
   *
   * @param {Caller} caller - The authenticated caller.
   * @param {Bytes<32>} blinding - The caller's blinding factor.
   *
   * @returns {IdentifierCommitment} accountCommitment - The computed account commitment.
   */
  circuit _computeAccountCommitment(caller: Caller, blinding: Blinding): IdentifierCommitment {
    const id = Identifier_unpack(caller.identifier);
    assert(id.kind == IdentifierKind.Key, "ShieldedAccessControl: contract caller");
    return computeAccountCommitment(id.bytes, blinding);
  }

  /**
   * @description Computes an `accountCommitment` without on-chain state. A grantee computes it off-chain
   * and hands it to the admin for {grantRole}, so the admin never sees the blinding factor.
   * Gives the same result as the in-circuit derivation for the same inputs.
   *
   * @warning The `blinding` is a secret. Anyone who learns it and the account can recompute the
   * holder's role commitments and nullifiers.
   *
   * ## Derivation
   * See {_computeAccountCommitment}.
   *
   * Requirements:
   *
   * - `account` is not zero.
   * - `blinding` is not zero.
   *
   * @param {Bytes<32>} account - The `left` of the holder's account.
   * @param {Bytes<32>} blinding - The holder's blinding factor.
   *
   * @returns {IdentifierCommitment} accountCommitment - The computed account commitment.
   */
  export pure circuit computeAccountCommitment(
                        account: Bytes<32>,
                        blinding: Blinding
                        ): IdentifierCommitment {
    assert(account != default<Bytes<32>>, "ShieldedAccessControl: zero account");
    assert(blinding as Bytes<32> != default<Bytes<32>>, "ShieldedAccessControl: zero blinding");
    return IdentifierCommitment_commit(
             pad(32, "ShieldedAccessControl:account"),
             account,
             blinding as Bytes<32>
             );
  }
}
