// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.5.0-alpha.2 (security/Blocklist.compact)

pragma language_version >= 0.28.0;

/**
 * @module Blocklist
 * @description A minimal, reusable deny-list keyed by an account: a key account
 * or a contract account. It answers a single question: is this account blocked?
 *
 * This module is a pure membership MECHANISM, not a policy. It holds no notion
 * of "when" the list is enforced and no access control. The mutators (`_block`,
 * `_unblock`) are deliberately UNGATED composable primitives: a composing
 * contract gates them behind its access-control module (the same way a token
 * gates `_mint` / `_burn`), and decides when to call `assertNotBlocked`. Keeping
 * the enforce-or-not decision in the composing layer leaves this module general
 * enough to back sanctions lists, account freezes, abuse denials, and the like.
 *
 * @dev Canonicalization
 * Every account is canonicalized before it is read from or written to
 * `_blocked`. Canonicalization zeroes out the inactive branch of the Either,
 * so two values with the same active branch always resolve to the same entry
 * regardless of what data the inactive branch carries.
 *
 * @notice This is the PUBLIC (transparent) blocklist: membership status is
 * publicly readable and the blocked set is publicly enumerable. That is the
 * right posture for transparent or public-graph assets. A graph-private asset
 * should instead use a shielded blocklist (a public blocklist would re-expose
 * the candidate set and bound the anonymity set).
 */
module Blocklist {
  import CompactStandardLibrary;

  import { Account } from "../account/Account";

  import "../utils/Utils" prefix Utils_;

  // ---------------------------------------------------------------------------
  // State
  // ---------------------------------------------------------------------------

  /**
   * @description Blocked accounts. Absent means not blocked.
   * @type {Set<Either<Bytes<32>, ContractAddress>>} _blocked
   */
  export ledger _blocked: Set<Account>;

  // ---------------------------------------------------------------------------
  // Views
  // ---------------------------------------------------------------------------

  /**
   * @description Returns whether `account` is currently blocked.
   *
   * @constraints k=8, rows=249
   *
   * @param {Either<Bytes<32>, ContractAddress>} account - The account to query.
   * @return {Boolean} - True if `account` is a member of the blocklist.
   */
  export circuit isBlocked(account: Account): Boolean {
    const canonAcct = Utils_canonicalize<Bytes<32>, ContractAddress>(account);
    return _blocked.member(disclose(canonAcct));
  }

  // ---------------------------------------------------------------------------
  // Check (the eligibility seam)
  // ---------------------------------------------------------------------------

  /**
   * @description Asserts that `account` is not blocked. The composing contract
   * decides when this gate applies.
   *
   * @constraints k=8, rows=231
   *
   * Requirements:
   *
   * - `account` is not a member of the blocklist.
   *
   * @param {Either<Bytes<32>, ContractAddress>} account - The account that must not be blocked.
   * @return {[]} - Empty tuple.
   */
  export circuit assertNotBlocked(account: Account): [] {
    assert(!isBlocked(account), "Blocklist: account blocked");
  }

  // ---------------------------------------------------------------------------
  // Mutators (UNGATED - the composing contract is responsible for gating these)
  // ---------------------------------------------------------------------------

  /**
   * @description Adds `account` to the blocklist.
   *
   * @constraints k=8, rows=225
   *
   * @param {Either<Bytes<32>, ContractAddress>} account - The account to block.
   * @return {[]} - Empty tuple.
   */
  export circuit _block(account: Account): [] {
    const canonAcct = Utils_canonicalize<Bytes<32>, ContractAddress>(account);
    _blocked.insert(disclose(canonAcct));
  }

  /**
   * @description Removes `account` from the blocklist.
   *
   * @constraints k=8, rows=223
   *
   * @param {Either<Bytes<32>, ContractAddress>} account - The account to unblock.
   * @return {[]} - Empty tuple.
   */
  export circuit _unblock(account: Account): [] {
    const canonAcct = Utils_canonicalize<Bytes<32>, ContractAddress>(account);
    _blocked.remove(disclose(canonAcct));
  }
}
