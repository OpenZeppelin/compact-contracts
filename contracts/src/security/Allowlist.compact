// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.5.0-alpha.2 (security/Allowlist.compact)

pragma language_version >= 0.28.0;

/**
 * @module Allowlist
 * @description A minimal, reusable permit-list keyed by an account: a key
 * account or a contract account. It answers a single question: is this account
 * a member?
 *
 * This module is a pure membership MECHANISM, not a policy. It holds no notion
 * of "when" the list is enforced and no access control. The mutators (`_allow`,
 * `_disallow`) are deliberately UNGATED composable primitives: a composing
 * contract gates them behind its access-control module (the same way a token
 * gates `_mint` / `_burn`), and decides when to call `assertAllowed` (for
 * example, only while an "eligibility required" flag is set). Keeping the
 * enforce-or-not decision in the composing layer leaves this module general
 * enough to back KYC allowlists, permissioned mints, membership gates, and the
 * like.
 *
 * @dev Canonicalization
 * Every account is canonicalized before it is read from or written to
 * `_allowed`. Canonicalization zeroes out the inactive branch of the Either,
 * so two values with the same active branch always resolve to the same entry
 * regardless of what data the inactive branch carries.
 *
 * @notice This is the PUBLIC (transparent) allowlist: membership status is
 * publicly readable and the approved set is publicly enumerable. That is the
 * right posture for transparent or public-graph assets. A graph-private asset
 * should instead use a shielded allowlist (a public allowlist would re-expose
 * the candidate set and bound the anonymity set).
 */
module Allowlist {
  import CompactStandardLibrary;

  import { Account } from "../account/Account";

  import "../utils/Utils" prefix Utils_;

  // ---------------------------------------------------------------------------
  // State
  // ---------------------------------------------------------------------------

  /**
   * @description Approved accounts. Absent means not allowed.
   * @type {Set<Either<Bytes<32>, ContractAddress>>} _allowed
   */
  export ledger _allowed: Set<Account>;

  // ---------------------------------------------------------------------------
  // Views
  // ---------------------------------------------------------------------------

  /**
   * @description Returns whether `account` is currently allowed.
   *
   * @constraints k=8, rows=249
   *
   * @param {Either<Bytes<32>, ContractAddress>} account - The account to query.
   * @return {Boolean} - True if `account` is a member of the allowlist.
   */
  export circuit isAllowed(account: Account): Boolean {
    const canonAcct = Utils_canonicalize<Bytes<32>, ContractAddress>(account);
    return _allowed.member(disclose(canonAcct));
  }

  // ---------------------------------------------------------------------------
  // Check (the eligibility seam)
  // ---------------------------------------------------------------------------

  /**
   * @description Asserts that `account` is allowed. The composing contract
   * decides when this gate applies.
   *
   * @constraints k=8, rows=229
   *
   * Requirements:
   *
   * - `account` is a member of the allowlist.
   *
   * @param {Either<Bytes<32>, ContractAddress>} account - The account that must be allowed.
   * @return {[]} - Empty tuple.
   */
  export circuit assertAllowed(account: Account): [] {
    assert(isAllowed(account), "Allowlist: account not allowed");
  }

  // ---------------------------------------------------------------------------
  // Mutators (UNGATED - the composing contract is responsible for gating these)
  // ---------------------------------------------------------------------------

  /**
   * @description Adds `account` to the allowlist.
   *
   * @constraints k=8, rows=225
   *
   * @param {Either<Bytes<32>, ContractAddress>} account - The account to allow.
   * @return {[]} - Empty tuple.
   */
  export circuit _allow(account: Account): [] {
    const canonAcct = Utils_canonicalize<Bytes<32>, ContractAddress>(account);
    _allowed.insert(disclose(canonAcct));
  }

  /**
   * @description Removes `account` from the allowlist.
   *
   * @constraints k=8, rows=223
   *
   * @param {Either<Bytes<32>, ContractAddress>} account - The account to disallow.
   * @return {[]} - Empty tuple.
   */
  export circuit _disallow(account: Account): [] {
    const canonAcct = Utils_canonicalize<Bytes<32>, ContractAddress>(account);
    _allowed.remove(disclose(canonAcct));
  }
}
