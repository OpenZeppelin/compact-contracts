   * @throws {Error} "Uint128: sqrt underestimate" if (root + 1)² <= radicand.
   *
   * @returns {Uint<64>} The floor of the square root of radicand.
   */
  export circuit sqrt(radicand: U128): Uint<64> {
    return _sqrt(radicand);
  }

