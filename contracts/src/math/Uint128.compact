   * @returns {U128} The smaller of a and b.
   */
  export pure circuit min(a: U128, b: U128): U128 {
    return lte(a, b) ? a : b;
  }

  /**
   * @title Max circuit
   * @description Returns the maximum of two Uint<128> values.
   *
   * @circuitInfo k=9, rows=360
   *
   * @param {Uint<128>} a - The first Uint<128> value.
