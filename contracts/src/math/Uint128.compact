   *
   * @circuitInfo k=12, rows=3824
   *
   * @param {Uint<128>} a - The Uint<128> value to check.
   * @param {Uint<128>} b - The Uint<128> b to test against.
   *
   * @throws {Error} "Uint128: division by zero" if b is zero.
   * @throws {Error} "Uint128: remainder error" if remainder is not less than b.
   * @throws {Error} "Uint128: division product overflow" if quotient * b does not fit in 128 bits.
   * @throws {Error} "Uint128: division invalid" if quotient * b + remainder does not equal a.
   *
   * @returns {Boolean} True if value is a multiple of b, false otherwise.
   */
  export circuit isMultiple(a: Uint<128>, b: Uint<128>): Boolean {
    const aU128 = toU128(a);
    const bU128 = toU128(b);
    return _isMultiple(aU128, bU128);
  }

