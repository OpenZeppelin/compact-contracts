// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.5.0-alpha.1 (math/Uint256.compact)

pragma language_version >= 0.26.0;

/**
 * @module Uint256
 *
 * @description A utility module providing constants, byte conversions and comparisons for 256-bit
 * unsigned integers using the U256 struct. It has no arithmetic yet (see the TODO list below). The U256 type represents numbers as
 * `high * 2^128 + low`, where high and low are U128 structs (each containing two Uint<64> limbs).
 *
 * @dev Supported Operations:
 * - Constants:
 *   - ZERO_U256(): Returns a U256 struct representing zero.
 *   - MAX_U256(): Returns maximum U256 (2^256 - 1).
 * - Conversions:
 *   - toBytes(value): Converts U256 to Bytes<32> (little-endian).
 *   - toUnpackedBytes(value): Converts U256 to Vector<32, Uint<8>> (little-endian).
 * - Comparisons:
 *   - eq(a, b): Checks if two U256 values are equal.
 *   - lt(a, b): Checks if one U256 value is less than another.
 *   - lte(a, b): Checks if one U256 value is less than or equal to another.
 *   - gt(a, b): Checks if one U256 value is greater than another.
 *   - gte(a, b): Checks if one U256 value is greater than or equal to another.
 *
 * TODO: Missing operations (available in other math modules):
 * - Arithmetic:
 *   - TODO: add(a, b): Add two U256 values.
 *   - TODO: addChecked(a, b): Add two U256 values with overflow checking.
 *   - TODO: sub(a, b): Subtract one U256 value from another.
 *   - TODO: mul(a, b): Multiply two U256 values.
 *   - TODO: mulChecked(a, b): Multiply two U256 values with overflow checking.
 * - Division:
 *   - TODO: div(a, b): Divide one U256 value by another.
 *   - TODO: rem(a, b): Compute remainder of U256 division.
 *   - TODO: divRem(a, b): Compute quotient and remainder of U256 division.
 * - Square Root:
 *   - TODO: sqrt(radicand): Compute floor of square root of a U256 value.
 * - Utilities:
 *   - TODO: isZero(a): Check if a U256 value equals zero.
 *   - TODO: isMultiple(a, b): Check if one U256 value is a multiple of another.
 *   - TODO: min(a, b): Return the smaller of two U256 values.
 *   - TODO: max(a, b): Return the larger of two U256 values.
 * - Conversions:
 *   - TODO: toField(value): Convert U256 to Field.
 */
module Uint256 {
  import { U128, U256 } from "./Types";

  import { pack } from "./Pack"<32> prefix Pack32_;
  import { toUnpackedBytes } from "./Uint64" prefix Uint64_;
  import { MAX_U128, eq, lt } from "./Uint128" prefix Uint128_;

  ////////////////////////////////////////////////////////////////
  // Constants
  ////////////////////////////////////////////////////////////////

  /**
   * @description Returns a U256 struct representing zero.
   *
   * @dev This circuit returns a U256 struct with all fields set to zero:
   * {low: {0, 0}, high: {0, 0}}, representing the 256-bit value 0.
   * No computations are performed, only struct construction.
   *
   * @constraints k=7, rows=63 (zkir-v2)
   * @constraints k=7, rows=71 (zkir-v3)
   *
   * @returns {U256} A U256 struct representing 0.
   * @deprecated Use `default<U256>` instead.
   */
  export pure circuit ZERO_U256(): U256 {
    return U256 { low: U128 { low: 0, high: 0 }, high: U128 { low: 0, high: 0 } };
  }

  /**
   * @description Returns the maximum value for a U256 struct, where both low and high
   * fields are set to the maximum 128-bit value (2^128 - 1).
   *
   * @constraints k=7, rows=66 (zkir-v2)
   * @constraints k=7, rows=74 (zkir-v3)
   *
   * @returns {U256} A U256 struct representing 2^256 - 1.
   */
  export pure circuit MAX_U256(): U256 {
    return U256 { low: Uint128_MAX_U128(), high: Uint128_MAX_U128() };
  }

  ////////////////////////////////////////////////////////////////
  // Conversions
  ////////////////////////////////////////////////////////////////

  /**
   * @description Converts a U256 to a Bytes<32> using little-endian byte ordering.
   *
   * @dev The conversion is done by first converting the U256 to unpacked bytes via
   * `toUnpackedBytes`, then casting the vector to `Bytes<32>`.
   *
   * @constraints k=14, rows=10271 (zkir-v2)
   * @constraints k=10, rows=628 (zkir-v3)
   *
   * Requirements:
   *
   * - The witness bytes of each 64-bit limb must recompose to the limb. Fails with "Uint64: toUnpackedBytes verification failed".
   *
   * @param {U256} value - The 256-bit value to convert.
   * @returns {Bytes<32>} - The 32-byte array representation.
   */
  export circuit toBytes(value: U256): Bytes<32> {
    const vector = toUnpackedBytes(value);
    return Pack32_pack(vector);
  }

  /**
   * @description Converts a U256 to a Vector<32, Uint<8>> using little-endian byte ordering.
   *
   * @dev This circuit converts a 256-bit unsigned integer into a 32-element vector of bytes.
   * Each 64-bit limb of the U256 is converted via `Uint64_toUnpackedBytes`, then the bytes
   * are assembled into the final vector.
   *
   * Limb ordering (little-endian):
   * - low.low   → bytes 0-7   (least significant)
   * - low.high  → bytes 8-15
   * - high.low  → bytes 16-23
   * - high.high → bytes 24-31 (most significant)
   *
   * @constraints k=11, rows=1031 (zkir-v2)
   * @constraints k=10, rows=658 (zkir-v3)
   *
   * Requirements:
   *
   * - The witness bytes of each 64-bit limb must recompose to the limb. Fails with "Uint64: toUnpackedBytes verification failed".
   *
   * @param {U256} value - The 256-bit value to convert.
   * @returns {Vector<32, Uint<8>>} - The 32-element byte vector representation.
   */
  export circuit toUnpackedBytes(value: U256): Vector<32, Uint<8>> {
    // Convert each limb into 8 bytes
    const lowLow = Uint64_toUnpackedBytes(value.low.low);
    const lowHigh = Uint64_toUnpackedBytes(value.low.high);
    const highLow = Uint64_toUnpackedBytes(value.high.low);
    const highHigh = Uint64_toUnpackedBytes(value.high.high);

    return [...lowLow, ...lowHigh, ...highLow, ...highHigh];
  }

  ////////////////////////////////////////////////////////////////
  // Comparisons
  ////////////////////////////////////////////////////////////////

  /**
   * @description Compares two U256 values to check if a == b.
   *
   * @dev Compares high and low U128 parts separately.
   *
   * @constraints k=10, rows=642 (zkir-v2)
   * @constraints k=9, rows=267 (zkir-v3)
   *
   * @param {U256} a - The first U256 value.
   * @param {U256} b - The second U256 value.
   * @returns {Boolean} True if a == b, false otherwise.
   */
  export pure circuit eq(a: U256, b: U256): Boolean {
    return Uint128_eq(a.high, b.high) && Uint128_eq(a.low, b.low);
  }

  /**
   * @description Compares two U256 values to check if a < b.
   *
   * @dev Checks high limbs first; if equal, falls back to low limbs.
   *
   * @constraints k=10, rows=768 (zkir-v2)
   * @constraints k=9, rows=314 (zkir-v3)
   *
   * @param {U256} a - The first U256 value.
   * @param {U256} b - The second U256 value.
   * @returns {Boolean} True if a < b, false otherwise.
   * @deprecated Use `(((a.high.high * 0x10000000000000000 + a.high.low) as Uint<128>) < ((b.high.high * 0x10000000000000000 + b.high.low) as Uint<128>) || (a.high == b.high && ((a.low.high * 0x10000000000000000 + a.low.low) as Uint<128>) < ((b.low.high * 0x10000000000000000 + b.low.low) as Uint<128>)))` instead.
   */
  export pure circuit lt(a: U256, b: U256): Boolean {
    return Uint128_lt(a.high, b.high) || (Uint128_eq(a.high, b.high) && Uint128_lt(a.low, b.low));
  }

  /**
   * @description Compares two U256 values to check if a <= b.
   *
   * @constraints k=10, rows=771 (zkir-v2)
   * @constraints k=9, rows=316 (zkir-v3)
   *
   * @param {U256} a - The first U256 value.
   * @param {U256} b - The second U256 value.
   * @returns {Boolean} True if a <= b, false otherwise.
   * @deprecated Use `!(((b.high.high * 0x10000000000000000 + b.high.low) as Uint<128>) < ((a.high.high * 0x10000000000000000 + a.high.low) as Uint<128>) || (b.high == a.high && ((b.low.high * 0x10000000000000000 + b.low.low) as Uint<128>) < ((a.low.high * 0x10000000000000000 + a.low.low) as Uint<128>)))` instead.
   */
  export pure circuit lte(a: U256, b: U256): Boolean {
    return !lt(b, a);
  }

  /**
   * @description Compares two U256 values to check if a > b.
   *
   * @constraints k=10, rows=768 (zkir-v2)
   * @constraints k=9, rows=314 (zkir-v3)
   *
   * @param {U256} a - The first U256 value.
   * @param {U256} b - The second U256 value.
   * @returns {Boolean} True if a > b, false otherwise.
   * @deprecated Use `(((b.high.high * 0x10000000000000000 + b.high.low) as Uint<128>) < ((a.high.high * 0x10000000000000000 + a.high.low) as Uint<128>) || (b.high == a.high && ((b.low.high * 0x10000000000000000 + b.low.low) as Uint<128>) < ((a.low.high * 0x10000000000000000 + a.low.low) as Uint<128>)))` instead.
   */
  export pure circuit gt(a: U256, b: U256): Boolean {
    return lt(b, a);
  }

  /**
   * @description Compares two U256 values to check if a >= b.
   *
   * @constraints k=10, rows=771 (zkir-v2)
   * @constraints k=9, rows=316 (zkir-v3)
   *
   * @param {U256} a - The first U256 value.
   * @param {U256} b - The second U256 value.
   * @returns {Boolean} True if a >= b, false otherwise.
   * @deprecated Use `!(((a.high.high * 0x10000000000000000 + a.high.low) as Uint<128>) < ((b.high.high * 0x10000000000000000 + b.high.low) as Uint<128>) || (a.high == b.high && ((a.low.high * 0x10000000000000000 + a.low.low) as Uint<128>) < ((b.low.high * 0x10000000000000000 + b.low.low) as Uint<128>)))` instead.
   */
  export pure circuit gte(a: U256, b: U256): Boolean {
    return !lt(a, b);
  }
}
