pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import { U128, U256 } from "../../Types";

ledger _invocations: Counter;

export circuit toBytesNative(value: Field): Bytes<32> {
  _invocations.increment(1);
  return value as Bytes<32>;
}

export circuit eqNative(a: Field, b: Field): Boolean {
  _invocations.increment(1);
  return a == b;
}

export circuit isZeroNative(a: Field): Boolean {
  _invocations.increment(1);
  return a == default<Field>;
}
