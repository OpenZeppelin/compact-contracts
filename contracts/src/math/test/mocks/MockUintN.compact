// SPDX-License-Identifier: MIT

// WARNING: FOR TESTING PURPOSES ONLY.
// This contract exposes the UintN module's circuits at three widths so they
// can be driven directly from off-chain tests. DO NOT deploy or use this
// contract in any production application.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "../../UintN"<8> prefix U8_;

import "../../UintN"<64> prefix U64_;

import "../../UintN"<248> prefix U248_;

// Pure, so a spec can sweep inputs without a ledger round trip per call.
export { U8_MODULUS, U8_wrappingAdd, U8_wrappingSub };
export { U64_MODULUS, U64_wrappingAdd, U64_wrappingSub };
export { U248_MODULUS, U248_wrappingAdd, U248_wrappingSub };

// Keeps every circuit below impure. Without a ledger write the compiler
// promotes them to pure, and the artifact ships without ZKIR or proving keys,
// leaving the circuits evaluated but never proven.
ledger _invocations: Counter;

////////////////////////////////////////////////////////////////
// N = 8
////////////////////////////////////////////////////////////////

export circuit MODULUS8(): Field {
  _invocations.increment(1);
  return U8_MODULUS();
}

export circuit wrappingAdd8(a: Uint<8>, b: Uint<8>): Uint<8> {
  _invocations.increment(1);
  return U8_wrappingAdd(a, b);
}

export circuit wrappingSub8(a: Uint<8>, b: Uint<8>): Uint<8> {
  _invocations.increment(1);
  return U8_wrappingSub(a, b);
}

////////////////////////////////////////////////////////////////
// N = 64
////////////////////////////////////////////////////////////////

export circuit MODULUS64(): Field {
  _invocations.increment(1);
  return U64_MODULUS();
}

export circuit wrappingAdd64(a: Uint<64>, b: Uint<64>): Uint<64> {
  _invocations.increment(1);
  return U64_wrappingAdd(a, b);
}

export circuit wrappingSub64(a: Uint<64>, b: Uint<64>): Uint<64> {
  _invocations.increment(1);
  return U64_wrappingSub(a, b);
}

////////////////////////////////////////////////////////////////
// N = 248
////////////////////////////////////////////////////////////////

export circuit MODULUS248(): Field {
  _invocations.increment(1);
  return U248_MODULUS();
}

export circuit wrappingAdd248(a: Uint<248>, b: Uint<248>): Uint<248> {
  _invocations.increment(1);
  return U248_wrappingAdd(a, b);
}

export circuit wrappingSub248(a: Uint<248>, b: Uint<248>): Uint<248> {
  _invocations.increment(1);
  return U248_wrappingSub(a, b);
}
