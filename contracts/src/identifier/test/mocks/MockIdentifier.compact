// WARNING: FOR TESTING PURPOSES ONLY.
// Exposes the Identifier module's circuit so it can be driven from off-chain
// tests. DO NOT deploy or use this contract in any production application.

pragma language_version >= 0.28.0;

import CompactStandardLibrary;

import { Identifier } from "../../Identifier";

import "../../Identifier" prefix Identifier_;

// Keeps the circuit impure. Without a ledger write the compiler promotes
// it to pure, and the artifact ships without ZKIR or proving keys, leaving
// the code evaluated but never proven.
ledger _invocations: Counter;

export circuit publicKeyOf(account: Identifier): Bytes<32> {
  _invocations.increment(1);
  return Identifier_publicKeyOf(account);
}
