// WARNING: FOR TESTING PURPOSES ONLY.
// Exposes the AccountCommitment module's circuit so it can be driven from
// off-chain tests. DO NOT deploy or use this contract in any production
// application.

pragma language_version >= 0.28.0;

import CompactStandardLibrary;

import { AccountCommitment } from "../../AccountCommitment";

import "../../AccountCommitment" prefix AccountCommitment_;

// Keeps the circuit impure. Without a ledger write the compiler promotes it
// to pure, and the artifact ships without ZKIR or proving keys, leaving the
// code evaluated but never proven.
ledger _invocations: Counter;

export circuit commit(
                 domain: Bytes<32>,
                 publicKey: Bytes<32>,
                 blinding: Bytes<32>
                 ): AccountCommitment {
  _invocations.increment(1);
  return AccountCommitment_commit(domain, publicKey, blinding);
}
