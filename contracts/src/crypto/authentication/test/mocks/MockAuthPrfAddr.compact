// WARNING: FOR TESTING PURPOSES ONLY.
// Exposes the AuthPrfAddr module's circuits so they can be driven from
// off-chain tests, and asserts the authenticator interface. DO NOT deploy or
// use this contract in any production application.

pragma language_version >= 0.28.0;

import CompactStandardLibrary;

import "../../interfaces/IAuthenticator";

import "../../AuthPrfAddr" prefix AuthPrfAddr_;

// Gives `authenticate` a proof. Without a ledger write the compiler emits no
// ZKIR or proving keys for it, leaving the code evaluated but never proven.
ledger _invocations: Counter;

// Fails to compile once `authenticate` below stops matching the interface.
contract implements IAuthenticator;

export circuit authenticate(salt: Bytes<32>): Caller {
  _invocations.increment(1);
  return disclose(AuthPrfAddr_authenticate(salt));
}

export circuit authenticateForThisContract(): Caller {
  return disclose(AuthPrfAddr_authenticateForThisContract());
}

export pure circuit deriveAccount(
                      secretKey: Bytes<32>,
                      salt: Bytes<32>
                      ): Either<Bytes<32>, ContractAddress> {
  return AuthPrfAddr_deriveAccount(secretKey, salt);
}
