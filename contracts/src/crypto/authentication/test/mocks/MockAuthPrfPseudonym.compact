// WARNING: FOR TESTING PURPOSES ONLY.
// Exposes the AuthPrfPseudonym module's circuits so they can be driven from
// off-chain tests. DO NOT deploy or use this contract in any production
// application.

pragma language_version >= 0.28.0;

import CompactStandardLibrary;

import { Caller } from "../../../../identifier/Identifier";

import "../../AuthPrfPseudonym" prefix AuthPrfPseudonym_;

// Gives `authenticate` a proof. Without a ledger write the compiler emits no
// ZKIR or proving keys for it, leaving the code evaluated but never proven.
ledger _invocations: Counter;

export circuit authenticate(salt: Bytes<32>): Caller {
  _invocations.increment(1);
  return disclose(AuthPrfPseudonym_authenticate(salt));
}

export circuit authenticateForThisContract(): Caller {
  return disclose(AuthPrfPseudonym_authenticateForThisContract());
}

export pure circuit deriveIdentifier(
                      secretKey: Bytes<32>,
                      salt: Bytes<32>
                      ): Either<Bytes<32>, ContractAddress> {
  return AuthPrfPseudonym_deriveIdentifier(secretKey, salt);
}
