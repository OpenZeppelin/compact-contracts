// SPDX-License-Identifier: MIT

// WARNING: FOR TESTING PURPOSES ONLY.
// Exposes the PrfAddr module's circuit so it can be driven from off-chain
// tests. DO NOT deploy or use this contract in any production application.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "../../PrfAddr" prefix PrfAddr_;

// Keeps the circuits impure. Without a ledger write the compiler promotes
// them to pure, and the artifact ships without ZKIR or proving keys, leaving
// the code evaluated but never proven.
ledger _invocations: Counter;

// Flat copy of the hashed `{ { domain, salt }, sk }`. `refDerivePk` hashes it
// without calling `PrfAddr` or `PrfCore`, so a spec checks `PrfAddr` against
// an independent encoding.
struct RefPreimage {
  domain: Bytes<32>;
  salt: Bytes<32>;
  sk: Bytes<32>;
}

export circuit derivePk(domain: Bytes<32>, salt: Bytes<32>, sk: Bytes<32>): Field {
  _invocations.increment(1);
  return PrfAddr_derivePk(domain, salt, sk);
}

export circuit refDerivePk(domain: Bytes<32>, salt: Bytes<32>, sk: Bytes<32>): Field {
  _invocations.increment(1);
  return degradeToTransient(
    persistentHash<RefPreimage>(RefPreimage { domain: domain, salt: salt, sk: sk })
  );
}
