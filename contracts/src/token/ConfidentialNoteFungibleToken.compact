// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.5.0-alpha.2 (token/ConfidentialNoteFungibleToken.compact)

pragma language_version >= 0.28.0;

/**
 * @module ConfidentialNoteFungibleToken<#depth, T>
 * @description
 * A note-based confidential token: amounts, sender, and recipient are hidden
 * from the public ledger.
 *
 * @dev Notation:
 * - `H(...)`: `persistentHash` (SHA-256), a `Bytes<32>` digest.
 * - `PRF_k(x)`: `PrfCore.evaluate(x, k)`, which is `H(x, k)`.
 * - `COMM_r(m)`: `HashCommitment.commit(domain, m, r)`, the stdlib
 *   `persistentCommit` over `{domain, m}`.
 * - NOTE: a UTxO `(value, nonce)`. A balance is the sum of one's unspent notes.
 * - `pk`: the owner key, a value of type `T`. The composer decides what it
 *   is and how an owner proves it.
 * - `cm = COMM_nonce(value, pk)` under `"CNFT:commitment"`: the commitment
 *   stored in the tree.
 * - `nf = PRF_nonce("CNFT:nullifier")`: the nullifier that marks a note
 *   spent.
 * - `tag = PRF_nonce("CNFT:issued")`: the issued tag that reserves a nonce at
 *   mint.
 * - A tag is its string padded to 32 bytes.
 *
 * @dev Derivations:
 * - `cm` is a hash commitment. `nonce` is its hiding randomness.
 * - `nf` and `tag` are one PRF keyed by `nonce`, evaluated at two domain
 *   tags. Without the nonce, neither links to the other or to `cm`.
 * - A default output nonce is `RandPrfExpand.derive` reduced to a `Field`.
 *   Its slot tag keeps the outputs of one call apart, and its context
 *   scopes a repeated seed: the recipient for a mint, the spent note's
 *   nonce for a change note, and both for a transfer's recipient note.
 * - Every hash covers its fields' Compact encodings in order, with no
 *   names and no boundaries. Do not reimplement one: `commitOf`,
 *   `nullifierOf` and `issuedTagOf` are pure circuits of
 *   `ConfidentialNoteFungibleTokenUtils`, and the compatibility suite pins
 *   their vectors.
 * - How `pk` is derived belongs to the composer. A wrong derivation yields
 *   notes that cannot be found and owners that cannot spend.
 * - No pure circuit covers a default nonce: the caller receives the note,
 *   so nothing off-chain recomputes it.
 *
 * @dev Parameterization:
 * Both parameters are fixed at import time
 * (`import "./ConfidentialNoteFungibleToken"<32, Bytes<32>> prefix Core_;`)
 * and are part of the deployed wire format: two instantiations that differ
 * in either are different contracts and share no notes.
 * - `#depth` is the commitment tree's depth. It sets capacity at `2^depth`
 *   notes and the length of every Merkle path.
 * - `T` is the owner-key type. The core never inspects a key: it hashes it
 *   into the commitment and, for `_mint`, into the nonce. A composer picks
 *   the type its ownership scheme produces, for example `Bytes<32>` (a
 *   public key), `Either<Bytes<32>, ContractAddress>` (a caller's account,
 *   so a contract can own notes), `Field` or `JubjubPoint`.
 *
 * @dev Compatibility:
 * The wire format is the `"CNFT:commitment"`, `"CNFT:nullifier"` and
 * `"CNFT:issued"` tags, the preimage layouts, `depth`, `T`, and the
 * composer's derivation of `pk`. Changing any of them orphans every existing
 * note. The compatibility suite pins the first three. The nonce tag
 * `"CNFT:nonce:core"` and its slots `"CNFT:mint"`, `"CNFT:out"` and
 * `"CNFT:change"` are sender-side: changing them orphans nothing.
 *
 * @notice Privacy:
 * - Public, per tx:
 *   - The entry point, so the operation type.
 *   - One `nf` per note spent.
 *   - One `tag` and one opaque leaf digest per note created.
 *   - The Merkle root the spend proves against.
 *   - The transcript shape, which does not vary with amount or recipient.
 * - Public, as state:
 *   - The commitment tree, the nullifier set, the issued-nonce set.
 *   - No balances, no accounts, no supply.
 * - Private:
 *   - Amounts.
 *   - Sender and recipient `pk`s. A `pk` lives only inside commitments. What
 *     it links to depends on how the composer derives it: a `pk` equal to an
 *     identity the same contract publishes (an owner, a role holder, a
 *     public-token account) lets anyone who knows it match the two.
 *   - Nonces and secret keys.
 *   - Which leaf a spend consumes, within the leaves present at the
 *     disclosed root. A stale root narrows that set to older leaves, and a
 *     rarely refreshed one fingerprints the wallet.
 *   - The link between a mint and its spend, absent the nonce.
 * - Counterparty: whoever knows a note's nonce derives its `tag` and `nf`, so
 *   sees WHEN it is minted and spent, not by whom or for how much.
 * - Auditability: no view key. Disclosure is per note, by sharing its nonce.
 *   Supply is not tracked; a composer adds it.
 *
 * @notice Security:
 * - Nonces are spend-critical: `nf` depends on the nonce alone, so anyone who
 *   knows a nonce derives the same nullifier and can race the owner for the
 *   single spend. This is also what lets a composer offer escrow-free
 *   clawback: two spends race for one `nf`, first to land wins.
 * - Freshness: the seed behind default nonces is `RandPrfExpand`'s, and it
 *   MUST be fresh and secret per circuit call. A zero seed is rejected.
 *   Outputs bind their context, and `_mintNote` rejects an already-issued
 *   nonce, so a repeated seed fails loudly instead of producing a dead
 *   note. A note handed to another party also binds its recipient, so a
 *   spend retried under the same seed to a different recipient gets a
 *   different nonce.
 * - Ownership: a spend proves `cm` binds the `pk` it is given. Proving that
 *   the caller is that owner is the composer's job.
 * - Conservation: `_transfer` and `_burn` cannot create value, since every
 *   output is computed from the consumed note. `_consumeNote` and
 *   `_mintNote` do no value accounting: a composer that pairs them MUST
 *   assert that what it mints does not exceed what it consumed.
 * - No authorization: `_mint`, `_mintNote`, `_transfer`, `_burn` and
 *   `_consumeNote` are ungated. Re-exporting one from a deployed contract is
 *   a permissionless mint or spend. The composer gates them.
 *
 * @notice Concurrency:
 * - Tree and set inserts commute; two calls collide only where they pin the
 *   same key.
 * - Spends pin `_nullifiers.member(nf)`: only two spends of the SAME note
 *   conflict.
 * - Mints pin `_issuedNonces.member(tag)`: only a duplicate nonce conflicts.
 * - `checkRoot` on the historic tree pins "root in history", so a proof built
 *   against a stale root still lands after concurrent inserts.
 * - Net: calls on distinct notes in one block all land; see the concurrency
 *   suite for the exhaustive pairwise matrix.
 *
 * @notice Scope:
 * Note machinery only: no roles, no identity and no setup step, and it
 * declares no witness. Every spend circuit takes the spender's `pk`, the
 * note it consumes and that note's Merkle path as arguments: the composer
 * authenticates the caller, maps it to a `pk` and passes it in. Created
 * notes return to the caller as a private result and reach recipients out of
 * band.
 *
 * @notice Client-side duties:
 * - Identity: derive `pk` the way the composing contract documents, and share
 *   it out of band.
 * - Implement `RandPrfExpand`'s seed witness. The core declares none.
 * - Pass each spend the note it consumes and the path entries from that
 *   note's commitment to a root the tree recognizes.
 * - Keep every note and its leaf position. There is no memo and no viewing
 *   key, so a chain rescan finds nothing: the seed restores identity, not
 *   balance. Notes need their own backup.
 * - Deliver notes to recipients over a channel you provide; the contract has
 *   no inbox. A recipient should confirm the leaf digest is in the tree
 *   before accepting.
 *
 * @notice Scalability:
 * - Capacity: `2^depth` notes per deployment; every output, including a
 *   zero-value change note, takes a leaf.
 * - State growth: `_nullifiers` and `_issuedNonces` gain one entry per note,
 *   and the historic tree keeps every past root. Nothing is pruned.
 * - One input per spend and no note merging: a balance spread over N notes
 *   needs N spends, and every transfer adds a change note.
 * - Throughput follows the concurrency rules above: calls on distinct notes
 *   commute.
 * - Wallets need no chain scanning, since notes arrive out of band, but must
 *   track Merkle paths, so an indexer over all leaves is required. Fetch the
 *   path right before proving: the root it yields is public.
 *
 * @dev Performance:
 * - Proving cost is per call and does not grow with the tree: the path is
 *   always `depth` deep, and each level costs a fixed number of rows.
 * - Cost is dominated by SHA-256. Every output pays the nonce, `cm` and `tag`
 *   hashes; a spend adds the input `cm`, `nf` and the path on top.
 * - `_transfer` is the largest circuit. Per-circuit `k` and rows are on each
 *   `@constraints` line, measured at `depth = 32` with `T = Field`. A wider
 *   `T` adds rows to every commitment.
 *
 * @dev Composition:
 * Value creation has no default gate. `_mint` / `_mintNote` are ungated, and
 * the composer decides who may create value. `_mint`, `_transfer` and
 * `_burn` are the default operations, with core-derived nonces. A composer
 * with its own nonce policy or output shape, such as several recipients or
 * a fee, pairs `_consumeNote` with `_mintNote` and asserts conservation
 * itself. A constructor cannot return, so a constructor-time mint is
 * `_mintNote` with a deployer-built note unless the same constructor records
 * the note on chain encrypted to its owner.
 *
 * A spend is gated the same way. With the caller's account as the owner
 * key (`T = Either<Bytes<32>, ContractAddress>`):
 *
 * ```compact
 * export circuit transfer(
 *   recipientPk: Either<Bytes<32>, ContractAddress>,
 *   value: Uint<128>,
 *   note: Core_Note,
 *   path: Vector<32, MerkleTreePathEntry>
 * ): [Core_Note, Core_Note] {
 *   const caller = AuthPrfAddr_authenticate(_noteSalt);
 *   return Core__transfer(
 *     caller.account,
 *     recipientPk,
 *     value,
 *     note,
 *     path
 *   );
 * }
 * ```
 */
module ConfidentialNoteFungibleToken<#depth, T> {
  import CompactStandardLibrary;

  import { Note, commitOf, issuedTagOf, nullifierOf }
    from "./utils/ConfidentialNoteFungibleTokenUtils";

  import "../crypto/randomness/RandPrfExpand" prefix RandPrfExpand_;

  // The note type, re-exported so a composer names it through this module.
  export { Note };

  /**
   * @description Append-only tree of note commitments: what value exists. It
   * does not prevent double-spends; that is `_nullifiers`' job.
   * @dev Historic, not plain:
   * `checkRoot` accepts any past root, so a proof survives concurrent inserts.
   * @type {HistoricMerkleTree<depth, Bytes<32>>} _commitments - The commitment
   * tree, holding up to `2^depth` leaves.
   */
  export ledger _commitments: HistoricMerkleTree<depth, Bytes<32>>;

  /**
   * @description Published nullifiers: what has been spent. Unlinkable to any
   * commitment, owner, or value, so to an observer who does not hold the note
   * the set reveals only a spend count. See the header's Privacy notice for
   * what a nonce-holder sees.
   * @type {Set<Bytes<32>>} _nullifiers - The spent-note nullifier set.
   */
  export ledger _nullifiers: Set<Bytes<32>>;

  /**
   * @description One tag per note ever committed. Separate from `_nullifiers`
   * so that set keeps meaning "spent". See `_mintNote`.
   * @type {Set<Bytes<32>>} _issuedNonces - The issued-tag set.
   */
  export ledger _issuedNonces: Set<Bytes<32>>;

  /**
   * @description Mints a note of `value` to `recipientPk` with a core-derived
   * nonce and returns it.
   *
   * @constraints k=14, rows=15845
   *
   * @notice Hidden amount and recipient:
   * The entry point makes the mint public; the amount and the recipient stay
   * hidden. An account-based token cannot offer this.
   *
   * @warning No authorization:
   * The composer gates who may call this.
   *
   * @warning Constructor use:
   * A constructor cannot return, so a note minted from one is unreachable
   * unless the same constructor records it on chain. Otherwise build the
   * note off-chain and call `_mintNote`.
   *
   * @dev Recipient-bound nonce:
   * With no note consumed, the nonce's context is `recipientPk`. Two calls
   * for one recipient under one seed derive the same nonce, and the second
   * fails. A composer minting twice to one recipient in one circuit, or
   * wanting its own nonce policy, calls `_mintNote`.
   *
   * @param {T} recipientPk - The owner key receiving the note.
   * @param {Uint<128>} value - The amount to create.
   * @return {Note} - The new note, returned as a local private result.
   */
  export circuit _mint(recipientPk: T, value: Uint<128>): Note {
    const note = Note {
      value: value,
      nonce: degradeToTransient(RandPrfExpand_derive<T>(
        pad(32, "CNFT:nonce:core"),
        pad(32, "CNFT:mint"),
        recipientPk
      ))
    };
    _mintNote(note, recipientPk);
    return disclose(note);
  }

  /**
   * @description Commits a caller-built note to `ownerPk`. No value
   * accounting: the caller owns conservation.
   *
   * @constraints k=14, rows=9983
   *
   * @notice Nonce reservation:
   * A duplicate nonce fails the transaction instead of committing a note born
   * dead, so every note in the tree carries a nonce no other note has.
   *
   * @dev Why not `_nullifiers`:
   * Inserting `nf` would spend the note at birth. A member-only check would
   * disclose `nf` at mint, linking mint to spend, and would miss two unspent
   * duplicates.
   *
   * @dev Weak seed:
   * The tag is as guessable as `nf`. A guessable seed exposes at mint what
   * `nf` exposes at spend, in return for catching the RNG break at once.
   *
   * @dev Why a set:
   * A counter or the tree index would pin one shared value and serialize
   * mints. `member` pins one key.
   *
   * @dev Domain separation:
   * Only the domain distinguishes the tag from `nullifierOf`, so neither set
   * can be read as the other.
   *
   * @dev Constructor mints:
   * The deployer builds the note and keeps its nonce, so this is the
   * constructor path when the composer does not record it on chain.
   *
   * @warning Predictable nonces:
   * The reservation is first come, first served and keyed on the nonce alone. A
   * caller-chosen nonce that others can guess, such as a counter or tx context,
   * lets anyone reserve it first and fail the intended mint. Derive nonces from
   * secret randomness, and on `nonce already issued` derive a fresh one rather
   * than retrying.
   *
   * @warning No authorization:
   * The composer gates who may call this.
   *
   * Requirements:
   *
   * - The note's nonce has not been issued before.
   *
   * @param {Note} note - The note to commit.
   * @param {T} ownerPk - The owner key that will own it.
   * @return {[]} - Empty tuple.
   */
  export circuit _mintNote(note: Note, ownerPk: T): [] {
    // Reserve before committing, so a duplicate fails with nothing written.
    const tag = issuedTagOf(note);
    assert(!_issuedNonces.member(disclose(tag)),
           "ConfidentialNoteFungibleToken: nonce already issued");
    _issuedNonces.insert(disclose(tag));
    _commitments.insert(disclose(commitOf<T>(note, ownerPk)));
  }

  /**
   * @description Burns `value` from `note`, owned by `spenderPk`:
   * spends the note and re-issues only the change with a core-derived nonce,
   * so `value` leaves circulation.
   *
   * @constraints k=15, rows=27298
   *
   * @notice No supply record:
   * The core writes no supply, so nothing on the ledger records that value was
   * destroyed. The amount and the burner stay hidden.
   *
   * @warning No authorization:
   * The composer gates who may call this.
   *
   * Requirements:
   *
   * - `note` is committed in the tree and unspent.
   * - Its commitment binds `spenderPk`.
   * - `path` leads from that commitment to a root the tree recognizes.
   * - `value <= note.value`.
   *
   * @param {T} spenderPk - The owner key of the input note.
   * @param {Uint<128>} value - The amount to burn.
   * @param {Note} note - The note to spend.
   * @param {Vector<depth, MerkleTreePathEntry>} path - The Merkle path
   * entries of the input note's commitment.
   * @return {Note} - The spender's change note, returned as a local private
   * result.
   */
  export circuit _burn(
                   spenderPk: T,
                   value: Uint<128>,
                   note: Note,
                   path: Vector<depth, MerkleTreePathEntry>
                   ): Note {
    _consumeNote(note, spenderPk, path);
    assert(note.value >= value,
           "ConfidentialNoteFungibleToken: insufficient note value");

    const changeNote = Note {
      value: (note.value - value) as Uint<128>,
      nonce: degradeToTransient(RandPrfExpand_derive<Field>(
        pad(32, "CNFT:nonce:core"),
        pad(32, "CNFT:change"),
        note.nonce
      ))
    };
    _mintNote(changeNote, spenderPk);
    return disclose(changeNote);
  }

  /**
   * @description The heart of the module: consumes `note`, owned by
   * `ownerPk`, and publishes its nullifier.
   *
   * @constraints k=14, rows=11466
   *
   * @notice Where it is used:
   * By `_transfer` and `_burn`, and by custom spend paths such as clawback,
   * where `ownerPk` is the target and the authorization is the caller's own.
   *
   * @dev Bound leaf:
   * The leaf is `commitOf(note, ownerPk)`, computed here. `path` carries the
   * sibling entries only, so a path for any other leaf yields a root the tree
   * does not recognize.
   *
   * @warning No value accounting:
   * Value leaves here and enters at `_mintNote`. A composer pairing the two
   * asserts conservation itself.
   *
   * @warning No authorization:
   * The composer gates who may call this.
   *
   * Requirements:
   *
   * - `note` is committed in the tree, under `ownerPk`, and unspent.
   * - `path` leads from its commitment to a root the tree recognizes, current
   *   or historical.
   *
   * @param {Note} note - The note to consume.
   * @param {T} ownerPk - The owner key the note is committed to.
   * @param {Vector<depth, MerkleTreePathEntry>} path - The `depth` sibling
   * entries from the note's commitment to the root.
   * @return {[]} - Empty tuple.
   */
  export circuit _consumeNote(
                   note: Note,
                   ownerPk: T,
                   path: Vector<depth, MerkleTreePathEntry>
                   ): [] {
    // The root is public and the path is not, so the root says only that the
    // consumed leaf predates it.
    const root = merkleTreePathRoot<depth, Bytes<32>>(
      MerkleTreePath<depth, Bytes<32>> {
        leaf: commitOf<T>(note, ownerPk),
        path: path
      }
    );
    assert(_commitments.checkRoot(disclose(root)),
           "ConfidentialNoteFungibleToken: input root not recognized");

    const nf = nullifierOf(note);
    assert(!_nullifiers.member(disclose(nf)),
           "ConfidentialNoteFungibleToken: note already spent");
    _nullifiers.insert(disclose(nf));
  }

  /**
   * @description Spends `note`, owned by `spenderPk`, and creates a
   * recipient note of `value` plus a change note back to `spenderPk`, with
   * core-derived nonces, conserving value.
   *
   * @constraints k=16, rows=43214
   *
   * @notice Local private result:
   * Both notes return to the caller, who hands the recipient note over out of
   * band and keeps the change.
   *
   * @dev Conservation:
   * The change is computed from the consumed note, so the two outputs sum to
   * the input by construction.
   *
   * @dev Recipient-bound nonce:
   * The recipient note's nonce binds `recipientPk` next to the spent nonce.
   * It is the one nonce another party learns.
   *
   * @warning No authorization:
   * The composer gates who may call this.
   *
   * Requirements:
   *
   * - `note` is committed in the tree and unspent.
   * - Its commitment binds `spenderPk`.
   * - `path` leads from that commitment to a root the tree recognizes.
   * - `value <= note.value`.
   *
   * @param {T} spenderPk - The owner key of the input note.
   * @param {T} recipientPk - The owner key receiving the output note.
   * @param {Uint<128>} value - The amount to send.
   * @param {Note} note - The note to spend.
   * @param {Vector<depth, MerkleTreePathEntry>} path - The Merkle path
   * entries of the input note's commitment.
   * @return {[Note, Note]} - The recipient's note and the spender's change
   * note.
   */
  export circuit _transfer(
                   spenderPk: T,
                   recipientPk: T,
                   value: Uint<128>,
                   note: Note,
                   path: Vector<depth, MerkleTreePathEntry>
                   ): [Note, Note] {
    _consumeNote(note, spenderPk, path);
    assert(note.value >= value,
           "ConfidentialNoteFungibleToken: insufficient note value");

    const outNote = Note {
      value: value,
      nonce: degradeToTransient(RandPrfExpand_derive<[Field, T]>(
        pad(32, "CNFT:nonce:core"),
        pad(32, "CNFT:out"),
        [note.nonce, recipientPk]
      ))
    };
    const changeNote = Note {
      value: (note.value - value) as Uint<128>,
      nonce: degradeToTransient(RandPrfExpand_derive<Field>(
        pad(32, "CNFT:nonce:core"),
        pad(32, "CNFT:change"),
        note.nonce
      ))
    };
    _mintNote(outNote, recipientPk);
    _mintNote(changeNote, spenderPk);
    return [disclose(outNote), disclose(changeNote)];
  }
}
