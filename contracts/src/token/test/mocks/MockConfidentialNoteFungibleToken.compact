// TEST-ONLY. Mock for the ConfidentialNoteFungibleToken core. Exposes a
// self-gated `transfer` / `burn` surface plus the `_`-prefixed building blocks,
// so the suite can drive the core the way a composing contract would. Circuits
// appear in the core's own order.
//
// The spend circuits read the caller's secret, the input note and its Merkle
// path from witnesses. The caller's key is `derivePk(sk, _instanceSalt)`.
// `derivePk` and `issuedTagOf` are test helpers, not core circuits.
//
// The building blocks are UNGATED by design: re-exporting `_mint` / `_mintNote`
// is a permissionless mint, and re-exporting `_consumeNote` lets any caller
// spend a note whose nonce they know. A PRODUCTION contract must gate them
// (see the core's module doc). DO NOT deploy this mock.
pragma language_version >= 0.28.0;

import CompactStandardLibrary;

import "../../../crypto/prf/PrfAddr" prefix PrfAddr_;
// Instantiated at depth 32, the deepest the ledger supports, with `Field` keys.
import "../../ConfidentialNoteFungibleToken"<32, Field> prefix Core_;
import "../../utils/ConfidentialNoteFungibleTokenUtils" prefix Utils_;

export { Core_Note }

export { Core__commitments, Core__nullifiers, Core__issuedNonces };

// The salt every caller key on this deployment is derived under.
sealed ledger _instanceSalt: Bytes<32>;

witness wit_ConfidentialNoteSK(): Bytes<32>;

witness wit_ConfidentialNoteInputNote(): Core_Note;

// Only the path's sibling entries reach the core, which rebuilds the leaf.
witness wit_ConfidentialNotePath(cm: Bytes<32>): MerkleTreePath<32, Bytes<32>>;

constructor(instanceSalt: Bytes<32>) {
  _instanceSalt = disclose(instanceSalt);
}

circuit callerPk(): Field {
  return derivePk(wit_ConfidentialNoteSK(), _instanceSalt);
}

circuit siblingsOf(note: Core_Note, ownerPk: Field): Vector<32, MerkleTreePathEntry> {
  return wit_ConfidentialNotePath(Utils_commitOf<Field>(note, ownerPk)).path;
}

export circuit _mint(recipientPk: Field, value: Uint<128>): Core_Note {
  return Core__mint(recipientPk, value);
}

export circuit _mintNote(note: Core_Note, ownerPk: Field): [] {
  return Core__mintNote(note, ownerPk);
}

export pure circuit commitOf(note: Core_Note, pk: Field): Bytes<32> {
  return Utils_commitOf<Field>(note, pk);
}

export circuit burn(value: Uint<128>): Core_Note {
  const pk = callerPk();
  const note = wit_ConfidentialNoteInputNote();
  return Core__burn(pk, value, note, siblingsOf(note, pk));
}

export pure circuit derivePk(sk: Bytes<32>, salt: Bytes<32>): Field {
  return degradeToTransient(
    PrfAddr_derivePk<Bytes<32>>(pad(32, "CNFT:pk"), salt, sk)
  );
}

export circuit _consumeNote(ownerPk: Field): Core_Note {
  const note = wit_ConfidentialNoteInputNote();
  Core__consumeNote(note, ownerPk, siblingsOf(note, ownerPk));
  // Exported-boundary marker: the consumed note returns only to the local
  // caller (who supplied it as a witness in the first place).
  return disclose(note);
}

export pure circuit nullifierOf(note: Core_Note): Bytes<32> {
  return Utils_nullifierOf(note);
}

export pure circuit issuedTagOf(note: Core_Note): Bytes<32> {
  return Utils_issuedTagOf(note);
}

export circuit transfer(recipientPk: Field, value: Uint<128>): [Core_Note, Core_Note] {
  const pk = callerPk();
  const note = wit_ConfidentialNoteInputNote();
  return Core__transfer(pk, recipientPk, value, note, siblingsOf(note, pk));
}
