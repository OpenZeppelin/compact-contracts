// WARNING: FOR TESTING PURPOSES ONLY.
// This contract takes the caller as a circuit argument, so anyone can act as
// any account, and it exposes internal circuits. DO NOT deploy or use this
// contract in any production application.

pragma language_version >= 0.28.0;

import CompactStandardLibrary;

import { Caller } from "../../../identifier/Identifier";

import "../../FungibleToken" prefix FungibleToken_;

export { Caller, ContractAddress, Either };

constructor(name_: Opaque<"string">, symbol_: Opaque<"string">, decimals_: Uint<8>) {
  FungibleToken_initialize(name_, symbol_, decimals_);
}

export circuit totalSupply(): Uint<128> {
  return FungibleToken_totalSupply();
}

export circuit balanceOf(account: Either<Bytes<32>, ContractAddress>): Uint<128> {
  return FungibleToken_balanceOf(account);
}

export circuit transfer(
  caller: Caller,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  return FungibleToken_transfer(caller, to, value);
}

export circuit _unsafeTransfer(
  caller: Caller,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  return FungibleToken__unsafeTransfer(caller, to, value);
}

export circuit allowance(
  owner: Either<Bytes<32>, ContractAddress>,
  spender: Either<Bytes<32>, ContractAddress>
): Uint<128> {
  return FungibleToken_allowance(owner, spender);
}

export circuit approve(
  caller: Caller,
  spender: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  return FungibleToken_approve(caller, spender, value);
}

export circuit transferFrom(
  caller: Caller,
  fromAddress: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  return FungibleToken_transferFrom(caller, fromAddress, to, value);
}

export circuit _unsafeTransferFrom(
  caller: Caller,
  fromAddress: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  return FungibleToken__unsafeTransferFrom(caller, fromAddress, to, value);
}

export circuit _mint(account: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
  return FungibleToken__mint(account, value);
}

export circuit _unsafeMint(account: Either<Bytes<32>, ContractAddress>, value: Uint<128>): [] {
  return FungibleToken__unsafeMint(account, value);
}
