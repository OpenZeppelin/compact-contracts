// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.4.0-alpha.3 (multisig/EcdsaSignerManager.compact)

pragma language_version >= 0.26.0;

/**
 * @module EcdsaSignerManager
 * @description k-of-n threshold authorization over secp256k1 ECDSA approvals
 * for multisig contracts.
 *
 * Signer identities are stored as commitments: `persistentHash` over the
 * signer's public-key coordinates, an instance salt, and a domain separator.
 * The salt is per-deployment, so the same public key yields a different
 * commitment in every instance and cannot be correlated across contracts.
 *
 * Wraps `Signer<Bytes<32>>` for the registry and threshold and configures it
 * from `initialize`. Consuming contracts own the digest: they compute the
 * message hash their signers signed, then hand it to `assertApprovals` with
 * one `Maybe<Approval>` slot per signer. A `some` slot is verified and counts
 * one approval; a `none` slot counts nothing.
 *
 * @notice Consuming contracts call `assertApprovals` with `m` equal to their
 * signer-set size, so every threshold up to that size is reachable. Proof cost
 * scales with `m`, not with the threshold.
 *
 * @notice Consuming contracts must not import `Signer` alongside this module.
 * A second import instantiates a separate registry that `assertApprovals`
 * never reads.
 */
module EcdsaSignerManager {
  import CompactStandardLibrary;
  import "../crypto/Ecdsa" prefix Ecdsa_;
  import "./Signer"<Bytes<32>> prefix Signer_;

  // Named import/re-export of the registry state only, so a consuming
  // contract's ledger keys read as `_signers` rather than `Signer__signers`.
  // The circuits stay behind the `Signer_` prefix.
  import { _signers, _signerCount, _threshold } from "./Signer"<Bytes<32>>;
  export { _signers, _signerCount, _threshold };

  /**
   * @description Deployment-supplied salt for signer commitments. Set at
   * initialization and never changed. The registered commitments must have been
   * derived under this same salt.
   */
  export sealed ledger _instanceSalt: Bytes<32>;

  /**
   * @description One signer's approval: the public key and its signature over
   * the operation digest.
   */
  export struct Approval {
    pubkey: Secp256k1Point,
    signature: Secp256k1EcdsaSignature
  }

  /**
   * @description Input to `persistentHash` for computing signer commitments.
   */
  struct SignerCommitmentInput {
    pkX: Bytes<32>,
    pkY: Bytes<32>,
    salt: Bytes<32>,
    domain: Bytes<32>
  }

  /**
   * @description Stores the instance salt and registers the initial signer set.
   * Call from the consuming contract's constructor only. Writes the `sealed`
   * salt, so it cannot be reached from an exported circuit.
   *
   * Requirements:
   *
   * - Can only be called once.
   * - `instanceSalt` should be cryptographically random.
   * - `signerCommitments` must not contain duplicates.
   * - `threshold` must be non-zero and must not exceed `n`.
   *
   * @param {Bytes<32>} instanceSalt - Per-deployment salt for commitment derivation.
   * @param {Vector<n, Bytes<32>>} signerCommitments - Hashed signer identities.
   * @param {Uint<8>} threshold - Minimum approvals required.
   * @returns {[]} Empty tuple.
   */
  export circuit initialize<#n>(
    instanceSalt: Bytes<32>,
    signerCommitments: Vector<n, Bytes<32>>,
    threshold: Uint<8>
  ): [] {
    assert(Signer_getSignerCount() == 0, "EcdsaSignerManager: signers already registered");
    _instanceSalt = disclose(instanceSalt);

    for (const commitment of signerCommitments) {
      Signer__addSigner(commitment);
    }
    Signer__changeThreshold(threshold);
  }

  /**
   * @description Computes a signer commitment from a secp256k1 public key,
   * as `persistentHash(pkX, pkY, salt, "multisig:signer:")`.
   *
   * Pure, so the deployer can derive constructor commitments off-chain the
   * same way the circuits derive them in-circuit.
   *
   * Requirements:
   *
   * - `pk` must not be the secp256k1 identity point, which has no coordinates.
   *
   * @param {Secp256k1Point} pk - The secp256k1 public key.
   * @param {Bytes<32>} salt - The instance salt.
   * @returns {Bytes<32>} The signer commitment.
   */
  export pure circuit calculateSignerId(
    pk: Secp256k1Point,
    salt: Bytes<32>
  ): Bytes<32> {
    return persistentHash<SignerCommitmentInput>(SignerCommitmentInput {
      pkX: secp256k1PointX(pk) as Bytes<32>,
      pkY: secp256k1PointY(pk) as Bytes<32>,
      salt: salt,
      domain: pad(32, "multisig:signer:")
    });
  }

  /**
   * @description Verifies the `some` slots of `approvals` over `msgHash` and
   * asserts their count meets the threshold.
   *
   * Approvals above the threshold are accepted. `none` slots are skipped, so a
   * consumer sized for its whole signer set accepts any `k` of them.
   *
   * @notice Verification goes through `Ecdsa`'s low-s wrapper, so the high-s
   * encoding of an approval is rejected as an invalid signature.
   *
   * @notice A `none` slot's public key is still hashed, so it must not be the
   * identity point. Fill it with the secp256k1 generator. Its signature is
   * replaced before verification and its registry query reads a zero key, so
   * the slot's contents are neither checked nor published.
   *
   * @constraints k=17, rows=95323 (zkir-v3)
   *
   * Requirements:
   *
   * - Every `some` public key must hash to a registered signer commitment.
   * - Every `some` signature must be valid over `msgHash` and use the low-s
   *   encoding.
   * - `some` slots must not repeat a signer.
   * - The number of `some` slots must meet the threshold.
   *
   * @param {Bytes<32>} msgHash - The digest the signers approved.
   * @param {Vector<m, Maybe<Approval>>} approvals - One slot per potential approver.
   * @returns {[]} Empty tuple.
   */
  export circuit assertApprovals<#m>(
    msgHash: Bytes<32>,
    approvals: Vector<m, Maybe<Approval>>
  ): [] {
    const salt = _instanceSalt;
    const commitments = map(
      (slot: Maybe<Approval>): Bytes<32> => verifyApproval(msgHash, salt, slot),
      approvals
    );

    for (const i of 0..m) {
      for (const j of 0..m) {
        assert(
          !(i < j) || !approvals[i].is_some || !approvals[j].is_some ||
            commitments[i] != commitments[j],
          "Multisig: duplicate signer"
        );
      }
    }

    Signer_assertThresholdMet(fold(
      (count: Uint<8>, slot: Maybe<Approval>): Uint<8> =>
        (slot.is_some ? count + 1 : count) as Uint<8>,
      0 as Uint<8>,
      approvals
    ));
  }

  /**
   * @description Verifies one approval slot and returns its signer commitment.
   * A `none` slot passes unchecked.
   *
   * @dev Both sides of every conditional are evaluated in-circuit, so a `none`
   * slot's signature is swapped for a digest-derived `(h, h)` that a verifier
   * can process, and the assertions are gated on `is_some`.
   *
   * @param {Bytes<32>} msgHash - The digest the signers approved.
   * @param {Bytes<32>} salt - The instance salt.
   * @param {Maybe<Approval>} slot - The approval to verify.
   * @returns {Bytes<32>} The slot's signer commitment.
   */
  circuit verifyApproval(
    msgHash: Bytes<32>,
    salt: Bytes<32>,
    slot: Maybe<Approval>
  ): Bytes<32> {
    const pubkey = slot.value.pubkey;
    const filler = msgHash as Secp256k1Scalar;
    const signature = slot.is_some
      ? slot.value.signature
      : Secp256k1EcdsaSignature { r: filler, s: filler };
    const commitment = calculateSignerId(pubkey, salt);

    const registered = Signer_isSigner(slot.is_some ? commitment : pad(32, ""));
    assert(!slot.is_some || registered, "Signer: not a signer");

    const verified = Ecdsa_secp256k1EcdsaVerifyLowS(msgHash, signature, pubkey);
    assert(!slot.is_some || verified, "Multisig: invalid signature");

    return commitment;
  }

  /**
   * @description Returns the number of registered signers.
   *
   * @constraints k=6, rows=34 (zkir-v3)
   *
   * @returns {Uint<8>} The signer count.
   */
  export circuit getSignerCount(): Uint<8> {
    return Signer_getSignerCount();
  }

  /**
   * @description Returns the approval threshold.
   *
   * @constraints k=6, rows=34 (zkir-v3)
   *
   * @returns {Uint<8>} The threshold.
   */
  export circuit getThreshold(): Uint<8> {
    return Signer_getThreshold();
  }

  /**
   * @description Returns whether the given commitment is a registered signer.
   *
   * @constraints k=8, rows=129 (zkir-v3)
   *
   * @param {Bytes<32>} commitment - The signer commitment to check.
   * @returns {Boolean} True if registered.
   */
  export circuit isSigner(commitment: Bytes<32>): Boolean {
    return Signer_isSigner(commitment);
  }
}
