// OpenZeppelin Compact Contracts v0.5.0-alpha.2 (multisig/examples/NativeShieldedTokenIssuerExample.compact)

pragma language_version >= 0.28.0;

/**
 * @title NativeShieldedTokenIssuerExample
 * @description Deployable reference contract for the `NativeShieldedTokenIssuer`
 * preset: a native shielded token whose supply enters only through an
 * ECDSA-authorized mint, to a holder (`mint`) or to the contract itself
 * (`mintToSelf`), and leaves only through an ECDSA-authorized burn, of a
 * holder's coin (`burn`) or of one the contract holds (`burnFromSelf`).
 *
 * Coins minted to holders are ordinary Zswap coins: holders transfer them
 * through Zswap without the issuer's involvement and redeem by paying one
 * into a `burn` tx. Only contract-held coins are locked. No send circuit
 * exists, so they leave through `burnFromSelf` alone.
 */

import CompactStandardLibrary;

import "../presets/NativeShieldedTokenIssuer"<2> prefix NativeShieldedTokenIssuer_;

export { ZswapCoinPublicKey, ContractAddress, Either, Maybe };

export { ShieldedCoinInfo, QualifiedShieldedCoinInfo };

// Surface the preset's state unprefixed so `ledger()` readers use the keys the
// modules declare.
import
  { _counter,
    _domainSeparator,
    _derivedNonceCounter,
    _instanceSalt,
    _signers,
    _signerCount,
    _threshold,
    _domain,
    _name,
    _symbol,
    _decimals,
    _isInitialized, }
  from "../presets/NativeShieldedTokenIssuer"<2>;

export { _counter,
         _domainSeparator,
         _derivedNonceCounter,
         _instanceSalt,
         _signers,
         _signerCount,
         _threshold,
         _domain,
         _name,
         _symbol,
         _decimals,
         _isInitialized, };

/**
 * @description Deploys the issuer with 3 signer commitments, a threshold
 * of 2, and the token's domain and metadata.
 *
 * Requirements:
 *
 * - `signerCommitments` must not contain duplicates.
 * - `instanceSalt` is not zero.
 * - `instanceSalt` should be cryptographically random.
 *
 * @param {Bytes<32>} instanceSalt - Random salt for signer commitment derivation.
 * @param {Bytes<32>} tokenDomain - Domain separator for this contract's token color.
 * @param {Opaque<"string">} name_ - The token name.
 * @param {Opaque<"string">} symbol_ - The token symbol.
 * @param {Uint<8>} decimals_ - The token decimals.
 * @param {Vector<3, Bytes<32>>} signerCommitments - Hashed signer identities.
 */
constructor(instanceSalt: Bytes<32>,
            tokenDomain: Bytes<32>,
            name_: Opaque<"string">,
            symbol_: Opaque<"string">,
            decimals_: Uint<8>,
            signerCommitments: Vector<3, Bytes<32>>,
            ) {
  NativeShieldedTokenIssuer_initialize<3>(
    instanceSalt,
    tokenDomain,
    name_,
    symbol_,
    decimals_,
    signerCommitments,
    );
}

/**
 * @description Computes a signer commitment from a secp256k1 public key, as
 * `persistentHash(pkX, pkY, salt, "Secp256k1EcdsaMultisig:signer")`.
 */
export pure circuit _calculateSignerId(pk: Secp256k1Point, salt: Bytes<32>): Bytes<32> {
  return NativeShieldedTokenIssuer__calculateSignerId(pk, salt);
}

/**
 * @description Mints a new shielded coin of this contract's token to
 * `recipient`, authorized by threshold signatures.
 *
 * @constraints k=17, rows=126141
 */
export circuit mint(amount: Uint<64>,
                    recipient: ZswapCoinPublicKey,
                    pubkeys: Vector<2, Secp256k1Point>,
                    signatures: Vector<2, Secp256k1EcdsaSignature>
                    ): ShieldedCoinInfo {
  return NativeShieldedTokenIssuer_mint(amount, recipient, pubkeys, signatures);
}

/**
 * @description Mints a new shielded coin of this contract's token to the
 * contract itself, claimed in the same call, authorized by threshold
 * signatures.
 *
 * @constraints k=17, rows=121920
 */
export circuit mintToSelf(
                 amount: Uint<64>,
                 pubkeys: Vector<2, Secp256k1Point>,
                 signatures: Vector<2, Secp256k1EcdsaSignature>
                 ): ShieldedCoinInfo {
  return NativeShieldedTokenIssuer_mintToSelf(amount, pubkeys, signatures);
}

/**
 * @description Burns `amount` from a holder's coin, authorized by threshold
 * signatures. The holder's transaction pays `coin` in; the contract receives it
 * and burns it in the same call. Any change goes to `refundTo`.
 *
 * @constraints k=18, rows=152672
 */
export circuit burn(coin: ShieldedCoinInfo,
                    amount: Uint<128>,
                    refundTo: ZswapCoinPublicKey,
                    pubkeys: Vector<2, Secp256k1Point>,
                    signatures: Vector<2, Secp256k1EcdsaSignature>
                    ): Maybe<ShieldedCoinInfo> {
  return NativeShieldedTokenIssuer_burn(coin, amount, refundTo, pubkeys, signatures);
}

/**
 * @description Burns `amount` from a coin this contract holds, authorized by
 * threshold signatures.
 *
 * @constraints k=18, rows=141953
 */
export circuit burnFromSelf(
                 coin: QualifiedShieldedCoinInfo,
                 amount: Uint<128>,
                 pubkeys: Vector<2, Secp256k1Point>,
                 signatures: Vector<2, Secp256k1EcdsaSignature>
                 ): Maybe<ShieldedCoinInfo> {
  return NativeShieldedTokenIssuer_burnFromSelf(coin, amount, pubkeys, signatures);
}

/**
 * @description Returns the counter the next operation's digest will bind to.
 *
 * @constraints k=6, rows=34
 */
export circuit getNonce(): Uint<64> {
  return NativeShieldedTokenIssuer_getNonce();
}

/**
 * @description Returns the token name.
 *
 * @constraints k=6, rows=45
 */
export circuit name(): Opaque<"string"> {
  return NativeShieldedTokenIssuer_name();
}

/**
 * @description Returns the token symbol.
 *
 * @constraints k=6, rows=45
 */
export circuit symbol(): Opaque<"string"> {
  return NativeShieldedTokenIssuer_symbol();
}

/**
 * @description Returns the token decimals.
 *
 * @constraints k=6, rows=45
 */
export circuit decimals(): Uint<8> {
  return NativeShieldedTokenIssuer_decimals();
}

/**
 * @description Returns this contract's token color, `tokenType(tokenDomain,
 * kernel.self())`.
 *
 * @constraints k=13, rows=3847
 */
export circuit tokenColor(): Bytes<32> {
  return NativeShieldedTokenIssuer_tokenColor();
}

/**
 * @description Returns the number of registered signers.
 *
 * @constraints k=6, rows=34
 */
export circuit getSignerCount(): Uint<8> {
  return NativeShieldedTokenIssuer_getSignerCount();
}

/**
 * @description Returns the approval threshold.
 *
 * @constraints k=6, rows=34
 */
export circuit getThreshold(): Uint<8> {
  return NativeShieldedTokenIssuer_getThreshold();
}

/**
 * @description Returns whether the given commitment is a registered signer.
 *
 * @constraints k=8, rows=129
 */
export circuit isSigner(commitment: Bytes<32>): Boolean {
  return NativeShieldedTokenIssuer_isSigner(commitment);
}
