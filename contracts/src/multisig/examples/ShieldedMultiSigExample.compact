// OpenZeppelin Compact Contracts v0.4.0-alpha.1 (multisig/examples/ShieldedMultiSigExample.compact)

pragma language_version >= 0.26.0;

/**
 * @title ShieldedMultiSigExample
 * @description Deployable reference contract for the `ShieldedMultiSig`
 * preset: a shielded treasury whose signers approve proposals that spend it
 * once the threshold is met.
 *
 * The signer set and threshold are fixed at deploy and the contract exposes no
 * reconfiguration circuit. Import the preset module directly to build a wallet
 * with a different signer count or a rotation policy.
 */

import CompactStandardLibrary;

import "../presets/ShieldedMultiSig" prefix ShieldedMultiSig_;

export { ZswapCoinPublicKey, ContractAddress, Either };
export { ShieldedCoinInfo, ShieldedSendResult };

// Surface the preset's approval state unprefixed so `ledger()` readers keep
// the key names the preset published as a contract.
import { _proposalApprovals, _approvalCount } from "../presets/ShieldedMultiSig";
export { _proposalApprovals, _approvalCount };

/**
 * @description Deploys the wallet with its signer set and approval threshold.
 *
 * Requirements:
 *
 * - `thresh` must be non-zero and must not exceed 3.
 * - `signers` must not contain duplicates.
 *
 * @param {Vector<3, Either<ZswapCoinPublicKey, ContractAddress>>} signers - The signer set.
 * @param {Uint<8>} thresh - The minimum number of approvals required.
 */
constructor(
  signers: Vector<3, Either<ZswapCoinPublicKey, ContractAddress>>,
  thresh: Uint<8>
) {
  ShieldedMultiSig_initialize(signers, thresh);
}

export circuit deposit(coin: ShieldedCoinInfo): [] {
  return ShieldedMultiSig_deposit(coin);
}

export circuit createShieldedProposal(
  to: ShieldedMultiSig_Proposal_Recipient,
  color: Bytes<32>,
  amount: Uint<128>
): Uint<64> {
  return ShieldedMultiSig_createShieldedProposal(to, color, amount);
}

export circuit approveProposal(id: Uint<64>): [] {
  return ShieldedMultiSig_approveProposal(id);
}

export circuit revokeApproval(id: Uint<64>): [] {
  return ShieldedMultiSig_revokeApproval(id);
}

export circuit executeShieldedProposal(id: Uint<64>): ShieldedSendResult {
  return ShieldedMultiSig_executeShieldedProposal(id);
}

export circuit isProposalApprovedBySigner(
  id: Uint<64>,
  signer: Either<ZswapCoinPublicKey, ContractAddress>
): Boolean {
  return ShieldedMultiSig_isProposalApprovedBySigner(id, signer);
}

export circuit getApprovalCount(id: Uint<64>): Uint<8> {
  return ShieldedMultiSig_getApprovalCount(id);
}

export circuit getProposal(id: Uint<64>): ShieldedMultiSig_Proposal_Proposal {
  return ShieldedMultiSig_getProposal(id);
}

export circuit getProposalStatus(id: Uint<64>): ShieldedMultiSig_Proposal_ProposalStatus {
  return ShieldedMultiSig_getProposalStatus(id);
}

export circuit getTokenBalance(color: Bytes<32>): Uint<128> {
  return ShieldedMultiSig_getTokenBalance(color);
}

export circuit getReceivedTotal(color: Bytes<32>): Uint<128> {
  return ShieldedMultiSig_getReceivedTotal(color);
}

export circuit getSentTotal(color: Bytes<32>): Uint<128> {
  return ShieldedMultiSig_getSentTotal(color);
}

export circuit getSignerCount(): Uint<8> {
  return ShieldedMultiSig_getSignerCount();
}

export circuit getThreshold(): Uint<8> {
  return ShieldedMultiSig_getThreshold();
}

export circuit isSigner(account: Either<ZswapCoinPublicKey, ContractAddress>): Boolean {
  return ShieldedMultiSig_isSigner(account);
}
