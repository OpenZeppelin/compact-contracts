// OpenZeppelin Compact Contracts v0.4.0-alpha.1 (multisig/examples/ShieldedMultiSigV3Example.compact)

pragma language_version >= 0.26.0;

/**
 * @title ShieldedMultiSigV3Example
 * @description Deployable reference contract for the `ShieldedMultiSigV3`
 * preset: a native shielded token whose supply enters only through an
 * ECDSA-authorized mint and leaves only through an ECDSA-authorized burn.
 *
 * The token is non-transferable by construction. There is no transfer circuit,
 * so a holder's only exit is to present the coin back for burn.
 */

import CompactStandardLibrary;

import "../presets/ShieldedMultiSigV3" prefix ShieldedMultiSigV3_;

export { ZswapCoinPublicKey, ContractAddress, Either };
export { QualifiedShieldedCoinInfo };

// Surface the preset's state unprefixed so `ledger()` readers keep the key
// names the preset published as a contract.
import { _counter, _coinNonce, _tokenDomain } from "../presets/ShieldedMultiSigV3";
export { _counter, _coinNonce, _tokenDomain };

/**
 * @description Deploys the issuer with 3 signer commitments and a threshold
 * of 2.
 *
 * Requirements:
 *
 * - `signerCommitments` must not contain duplicates.
 * - `instanceSalt` and `initCoinNonce` should be cryptographically random.
 *
 * @param {Bytes<32>} instanceSalt - Random salt for signer commitment derivation.
 * @param {Bytes<32>} initCoinNonce - Initial coin nonce seed.
 * @param {Bytes<32>} tokenDomain - Domain string used to derive this contract's token color.
 * @param {Vector<3, Bytes<32>>} signerCommitments - Hashed signer identities.
 */
constructor(
  instanceSalt: Bytes<32>,
  initCoinNonce: Bytes<32>,
  tokenDomain: Bytes<32>,
  signerCommitments: Vector<3, Bytes<32>>,
) {
  ShieldedMultiSigV3_initialize(
    instanceSalt,
    initCoinNonce,
    tokenDomain,
    signerCommitments
  );
}

export circuit mint(
  amount: Uint<64>,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  pubkeys: Vector<2, Secp256k1Point>,
  signatures: Vector<2, Secp256k1EcdsaSignature>
): [] {
  return ShieldedMultiSigV3_mint(amount, recipient, pubkeys, signatures);
}

export circuit burn(
  coin: QualifiedShieldedCoinInfo,
  amount: Uint<64>,
  pubkeys: Vector<2, Secp256k1Point>,
  signatures: Vector<2, Secp256k1EcdsaSignature>
): [] {
  return ShieldedMultiSigV3_burn(coin, amount, pubkeys, signatures);
}

export pure circuit _calculateSignerId(
  pk: Secp256k1Point,
  salt: Bytes<32>
): Bytes<32> {
  return ShieldedMultiSigV3__calculateSignerId(pk, salt);
}

export circuit getNonce(): Uint<64> {
  return ShieldedMultiSigV3_getNonce();
}

export circuit getTokenDomain(): Bytes<32> {
  return ShieldedMultiSigV3_getTokenDomain();
}

export circuit getTokenType(): Bytes<32> {
  return ShieldedMultiSigV3_getTokenType();
}

export circuit getSignerCount(): Uint<8> {
  return ShieldedMultiSigV3_getSignerCount();
}

export circuit getThreshold(): Uint<8> {
  return ShieldedMultiSigV3_getThreshold();
}

export circuit isSigner(commitment: Bytes<32>): Boolean {
  return ShieldedMultiSigV3_isSigner(commitment);
}
