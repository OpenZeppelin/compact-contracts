// SPDX-License-Identifier: MIT
// OpenZeppelin Compact Contracts v0.5.0-alpha.2 (multisig/presets/NativeShieldedStatelessTreasury.compact)

pragma language_version >= 0.28.0;

/**
 * @module NativeShieldedStatelessTreasury
 * @description
 * A threshold ECDSA multisig treasury for shielded coins. Anyone may
 * deposit; value leaves only through `execute`, a single tx carrying `t`
 * registered signers' approvals. There is no proposal lifecycle: signatures
 * are collected off-chain and verified in that one tx.
 *
 * Composes `Secp256k1EcdsaMultisig` (signer commitments, approval checks),
 * `ShieldedTreasuryStateless` as `Treasury_` (deposit and send, no coin
 * state on the ledger) and `ProposalManager` as `Proposal_` for its
 * `Recipient` and `RecipientKind` types alone.
 *
 * @dev Notation:
 * - `H<T>(...)`: `persistentHash<T>` (SHA-256) over the Compact encoding of
 *   `T`, a `Bytes<32>` digest.
 * - `keccak(...)`: `keccak256` over the concatenation of its 32-byte words.
 * - `DS`: `_domainSeparator`, the EIP-712 domain separator fixed at
 *   construction.
 * - `self`: `kernel.self().bytes`, this contract's address.
 * - `nonce`: the `_nonce` value read at the start of `execute`, the
 *   signature replay counter.
 * - `cm`: a signer commitment, the registry key.
 *
 * @dev Derivations:
 * - Domain separator: `DS = Eip712_domainSeparator(
 *   keccak("NativeShieldedStatelessTreasury"), keccak("1"), instanceSalt)`,
 *   the EIP-712 domain `(name, version, salt)`. `chainId` and
 *   `verifyingContract` are absent: no network id is available in-circuit
 *   and a 32-byte address does not fit `address`. `self` inside the struct
 *   separates deployments instead.
 * - Execute digest: `keccak(0x1901 ‖ DS ‖ keccak([EXECUTE_TYPEHASH, self,
 *   uint64Word(nonce), uint8Word(to.kind), to.address, coin.color,
 *   uint128Word(amount)]))`.
 * - Type hash: `EXECUTE_TYPEHASH = keccak("Execute(bytes32 contractAddress,
 *   uint256 nonce,uint8 recipientKind,bytes32 recipient,bytes32 coinColor,
 *   uint256 amount)")`, written as a literal word.
 * - Signer commitment: `cm = H<SignerCommitmentInput>({ pkX, pkY, salt,
 *   domain: pad(32, "Secp256k1EcdsaMultisig:signer") })`, `pkX` / `pkY`
 *   the affine coordinates as `Bytes<32>`. `_calculateSignerId` is the
 *   exported pure circuit.
 * - Encoding: `H` hashes the Compact encoding, not a byte concatenation.
 *   Digest integers are big-endian ABI words (`utils/EvmAbi`), so an EVM
 *   signer's typed-data encoder reproduces them.
 *   `contracts/src/multisig/test/EcdsaTestUtils.ts` pins the digest through
 *   ethers (`executeMsgHash`).
 *
 * @notice Implementing contracts register the signer set from their
 * constructor by calling this module's `initialize`, and MUST NOT import
 * `Signer` or `Secp256k1EcdsaMultisig` directly.
 *
 * @dev Parameterization:
 * `t` is the approval width and the threshold, fixed at import
 * (`"../presets/NativeShieldedStatelessTreasury"<t>`): `execute` verifies
 * exactly `t` distinct signers. The implementing contract fixes the signer
 * count `n` at `initialize`. Import one width per contract: two widths share
 * one signer registry, see `Secp256k1EcdsaMultisig`.
 * `NativeShieldedStatelessTreasuryExample` fixes 2-of-3. The `@constraints`
 * tag on `execute` is measured at `t = 2`.
 *
 * @dev Compatibility:
 * The wire format the signers implement is the EIP-712 domain
 * (`NativeShieldedStatelessTreasury`, version `1`, salt), the `Execute` type
 * string, the `Secp256k1EcdsaMultisig:signer` commitment domain (owned by
 * `Secp256k1EcdsaMultisig`), the `cm` preimage struct, and the `Vector<t>` /
 * `Vector<n>` shapes the implementing contract fixes. Changing any of them
 * breaks every existing signer setup. The test suite pins them through
 * `EcdsaTestUtils.ts`.
 *
 * @notice Privacy:
 * - Public, per tx:
 *   - Entry point: `deposit` or `execute`.
 *   - Approvers: the `t` signer commitments (`disclose(commitment)` in
 *     `Signer_assertSigner`), so WHICH signers approved.
 *   - Deposit: the coin commitment as a receive claim, with this contract
 *     named in the Zswap output (`disclose(coin)` in `Treasury__deposit`).
 *   - Execute: the spent coin's nullifier and the sent and change coin
 *     commitments. The returned `ShieldedSendResult` stays with the caller.
 * - Public, as state:
 *   - Cells: `_nonce`, `_domainSeparator`, and the `Secp256k1EcdsaMultisig`
 *     cells (`_signers`, `_signerCount`, `_threshold`, `_instanceSalt`)
 *     behind its prefix. `_nonce` and `_domainSeparator` are exported, so an
 *     implementing contract can surface them in its `ledger()` reader, as
 *     the example does; the rest are read through the view circuits.
 *   - Absent: no coin map, no balances, no received or sent totals.
 * - Private:
 *   - Signer material: public keys and signatures are verified in-circuit,
 *     never disclosed.
 *   - Operation data: the amount and the recipient.
 * - Signer identity: keys sit behind `cm` with a public salt, so an observer
 *   holding a candidate key can test membership; one without cannot
 *   correlate a signer across deployments.
 * - Auditability: no balance is stored, but a coin commitment is a hash of
 *   the coin's data, so whoever knows a held coin can link its receive to
 *   its later spend. The change coin's nonce derives from the spent coin's,
 *   so that observer can follow the change too.
 *
 * @notice Security:
 * - Digest binding: the `Execute` struct binds its type hash, `self`,
 *   `nonce`, the recipient kind and address, `coin.color` and `amount` under
 *   `DS`, so a signature authorizes one spend on one instance at one nonce,
 *   and is neither replayable nor redirectable. Removing the `self` word
 *   removes cross-instance replay protection, since `DS` cannot carry the
 *   address.
 * - Low-s: verification goes through `Ecdsa_secp256k1EcdsaVerifyLowS`, so a
 *   high-s encoding is an invalid signature.
 * - Distinct signers: `assertApprovals` takes exactly `t` keys and rejects a
 *   repeated commitment, so no set of fewer than `t` registered signers
 *   moves value. `initialize` rejects `n < t`.
 * - Recipient kind: `execute` rejects any recipient but a `ShieldedUser`. A
 *   contract-addressed coin would be unclaimable, making the transaction
 *   malformed.
 * - Open deposits: `deposit` has no access control, by design. Only
 *   `execute` moves value out.
 * - No coin bookkeeping: with no coin registry, a double spend or a coin the
 *   contract does not own is rejected by the protocol at application time
 *   rather than by an assert here. Sufficiency (`coin.value >= amount`) is
 *   likewise left to `sendShielded`.
 * - Immutable signer set: no signer reconfiguration circuit is exported, so
 *   the commitments and the threshold are fixed. Losing more than `n - t`
 *   keys freezes spending.
 * - Atomicity: a failed assert rejects the whole tx before any state moves;
 *   the nonce does not advance and the sender pays no fee.
 *
 * @notice Concurrency:
 * - Replay nonce: `execute` reads `_nonce` into the digest. The read is
 *   pinned, so any two executes in one block conflict: at most one lands per
 *   block, and the losing signers re-sign at the next nonce.
 * - `getNonce`: submitted as a tx it pins `_nonce` and conflicts with a
 *   same-block `execute`.
 * - Deposits: `deposit` writes no ledger state, so it commutes with
 *   everything, a same-block `execute` included.
 * - Views: the signer views read only state written by `initialize`, so they
 *   commute with everything.
 *
 * @notice Scope:
 * Deposit and send only. No mint, no burn, no unshielded rail, and no
 * on-chain proposal: `ProposalManager` is imported for `Proposal_Recipient`
 * and `Proposal_RecipientKind` only, while its `_proposals` map and
 * `_nextProposalId` are allocated by the import and never written. `execute`
 * checks `to.kind` itself rather than calling `toShieldedRecipient`. Coins
 * the treasury holds are ordinary Zswap coins it neither tracks nor
 * restricts.
 *
 * @notice Client-side duties:
 * - Before deploy: pick a random `instanceSalt`, derive each `cm` with
 *   `_calculateSignerId(pk, salt)`, pass them as `signerCommitments`.
 * - Per operation: read `getNonce()`, rebuild the digest as
 *   `EcdsaTestUtils.ts` does, collect `t` low-s signatures off-chain, submit
 *   keys and signatures in matching `Vector<t>` positions.
 * - Coin tracking: keep the treasury's coins off-chain, recovering each
 *   coin's `mt_index` from the indexer's `ZswapOutput` / ledger events to
 *   build the `QualifiedShieldedCoinInfo` that `execute` takes.
 * - Change coin: persist the one `execute` returns. `sendShielded` emits it
 *   as a fresh self-owned output, and it replaces the spent coin as the
 *   treasury's holding.
 *
 * @notice Scalability:
 * - Throughput: one `execute` per block (see Concurrency). Deposits write no
 *   ledger state, so they do not contend.
 * - State: constant-size, one counter, the domain separator and an
 *   `n`-entry signer set. Nothing grows per deposit or spend.
 * - Coins: no merge circuit, so the off-chain pool gains one coin per
 *   deposit and `execute` spends exactly one of them. A spend larger than
 *   the largest single coin is not expressible.
 * - Amounts: `execute` takes `Uint<128>`.
 *
 * @dev Composition:
 * - On-chain balances: swap `ShieldedTreasuryStateless` for
 *   `ShieldedTreasury` to get one merged UTXO per color and cumulative
 *   totals, both published.
 * - Unshielded rail: pair `Proposal_toUnshieldedRecipient` with
 *   `UnshieldedTreasury`; this preset wires only the shielded one.
 * - Other thresholds: import at another `t` (see Parameterization).
 * - Proposal lifecycle: wire in the rest of `ProposalManager` for on-chain
 *   proposals, at the cost its own `@warning` names: every proposal's
 *   recipient, color and amount becomes public.
 */
module NativeShieldedStatelessTreasury<#t> {
  import CompactStandardLibrary;

  import "../Secp256k1EcdsaMultisig"<t> prefix Secp256k1EcdsaMultisig_;
  import "../../crypto/Eip712" prefix Eip712_;
  import "../../utils/EvmAbi" prefix EvmAbi_;
  import "../ProposalManager" prefix Proposal_;
  import "../ShieldedTreasuryStateless" prefix Treasury_;

  // Implementing contracts need this for the re-exported `execute` signature.
  // Importing `ProposalManager` again instead would give them a second,
  // unwritten copy of its state.
  export { Proposal_Recipient };

  /**
   * @description Signature replay counter. `execute` reads it into its
   * digest and increments it; `getNonce` returns the value the next digest
   * binds to. The read is pinned, so at most one `execute` lands per block.
   * Exported so the implementing contract's `ledger()` reader can surface it.
   */
  export ledger _nonce: Counter;

  /**
   * @description The EIP-712 domain separator every `execute` digest is built
   * under, derived from `(name, version, instanceSalt)`. Set once at
   * construction.
   */
  export sealed ledger _domainSeparator: Bytes<32>;

  /**
   * @description Registers the signer set at threshold `t` and fixes the
   * EIP-712 domain separator.
   *
   * @notice Call from the implementing contract's constructor only. It writes
   * the `sealed` `_domainSeparator`, so implementing contracts MUST NOT expose
   * `initialize` as a post-deploy circuit.
   *
   * The EIP-712 domain fixed here is `(name, version, salt)`. `chainId` and
   * `verifyingContract` are absent: no network identifier is available
   * in-circuit, and a 32-byte Midnight address does not fit
   * `verifyingContract`'s `address` type.
   *
   * Replay protection comes from `execute` binding `kernel.self()` in its
   * struct rather than from the domain. The ledger randomizes a contract's
   * address at deployment, so no two deployments share one on any network.
   * A signature for one cannot authorize another.
   *
   * `instanceSalt` also keys the signer commitments, so a fresh value per
   * deployment keeps one public key from producing the same commitment in two
   * deployments which would link the signer set across them.
   *
   * Requirements:
   *
   * - `instanceSalt` should be cryptographically random.
   * - `signerCommitments` must not contain duplicates.
   * - `n` must be at least `t`.
   *
   * @param {Bytes<32>} instanceSalt - Per-deployment salt for commitment derivation.
   * @param {Vector<n, Bytes<32>>} signerCommitments - Hashed signer identities.
   * @returns {[]} Empty tuple.
   */
  export circuit initialize<#n>(
    instanceSalt: Bytes<32>,
    signerCommitments: Vector<n, Bytes<32>>
  ): [] {
    Secp256k1EcdsaMultisig_initialize<n>(instanceSalt, signerCommitments);

    const hashedName = keccak256<Bytes<31>>(pad(31, "NativeShieldedStatelessTreasury"));
    const hashedVersion = keccak256<Bytes<1>>(pad(1, "1"));
    _domainSeparator = Eip712_domainSeparator(
      hashedName,
      hashedVersion,
      disclose(instanceSalt)
    );
  }

  /**
   * @description `keccak256` of the `Execute` type string:
   * `Execute(bytes32 contractAddress,uint256 nonce,uint8 recipientKind,bytes32 recipient,bytes32 coinColor,uint256 amount)`
   *
   * @dev Written as a literal word. `compactc` emits a full keccak
   * permutation even for a constant argument, so hashing the type string
   * in-circuit would add ~4.2k rows to every `execute`. The spec checks this
   * word against the type string above.
   *
   * @returns {Bytes<32>} The `Execute` type hash.
   */
  pure circuit EXECUTE_TYPEHASH(): Bytes<32> {
    const typeHash: Vector<32, Uint<8>> = [
      0x8e, 0x36, 0xc9, 0x78, 0xf2, 0x00, 0x15, 0xe8,
      0x1d, 0x7a, 0x53, 0xef, 0xc3, 0x2e, 0x2b, 0x08,
      0xf1, 0x24, 0x97, 0xa5, 0x05, 0x7c, 0x70, 0x20,
      0x7f, 0x8b, 0xc4, 0xb7, 0xc6, 0xcf, 0x5e, 0x15
    ];

    return typeHash as Bytes<32>;
  }

  /**
   * @description Computes a signer commitment from a secp256k1 public key,
   * as `persistentHash(pkX, pkY, salt, "Secp256k1EcdsaMultisig:signer")`.
   *
   * Pure, so the deployer can derive constructor commitments off-chain.
   *
   * Requirements:
   *
   * - `pk` must not be the secp256k1 identity point, which has no coordinates.
   *
   * @param {Secp256k1Point} pk - The secp256k1 public key.
   * @param {Bytes<32>} salt - The instance salt.
   *
   * @returns {Bytes<32>} The signer commitment.
   */
  export pure circuit _calculateSignerId(
    pk: Secp256k1Point,
    salt: Bytes<32>
  ): Bytes<32> {
    return Secp256k1EcdsaMultisig_calculateSignerId(pk, salt);
  }

  /**
   * @description Receives a shielded coin into the multisig treasury.
   *
   * No access control which allows anyone to deposit. The coin is claimed at the
   * protocol level through receiveShielded. No coin data is stored on the
   * public ledger, preserving full balance privacy.
   *
   * The operator discovers the coin's Merkle tree index by subscribing
   * to ZswapOutput events via the indexer, filtering by contract address,
   * and extracting mt_index. Combined with the known ShieldedCoinInfo,
   * this produces the QualifiedShieldedCoinInfo needed for spending.
   *
   * @constraints k=13, rows=5898
   *
   * @param {ShieldedCoinInfo} coin - The incoming shielded coin.
   */
  export circuit deposit(coin: ShieldedCoinInfo): [] {
    Treasury__deposit(coin);
  }

  /**
   * @description Executes a shielded send authorized by threshold signatures.
   *
   * The circuit reads the current nonce from the ledger, increments it,
   * then reconstructs the EIP-712 digest that signers must have signed
   * off-chain: the `Execute` struct (contract address, nonce, recipient kind,
   * recipient, coin color, amount) hashed under this deployment's domain
   * separator. The digest is bound to the contract instance and the full recipient (kind and
   * address), so a signature authorizes exactly one operation on one instance.
   *
   * Approvals are checked by `Secp256k1EcdsaMultisig`, which derives each
   * signer's commitment from their public key and the instance salt and
   * rejects duplicates. Constraints below are measured at `t = 2`.
   *
   * @notice `to` must be a `ShieldedUser`. A contract-addressed coin would be
   * unclaimable, making the transaction malformed.
   *
   * @constraints k=18, rows=131823
   *
   * Requirements:
   *
   * - No two entries may be the same signer.
   * - Every public key must hash to a registered signer commitment.
   * - Every signature must be valid over the message hash and use the low-s
   *   encoding.
   * - `to.kind` must be `ShieldedUser`.
   * - Coin value must be >= amount.
   *
   * @param {Proposal_Recipient} to - The recipient.
   * @param {Uint<128>} amount - The amount to send.
   * @param {QualifiedShieldedCoinInfo} coin - The coin to spend (from operator's pool).
   * @param {Vector<t, Secp256k1Point>} pubkeys - Public keys of approving signers.
   * @param {Vector<t, Secp256k1EcdsaSignature>} signatures - ECDSA signatures over the operation.
   *
   * @returns {ShieldedSendResult} The send result including any change.
   */
  export circuit execute(
    to: Proposal_Recipient,
    amount: Uint<128>,
    coin: QualifiedShieldedCoinInfo,
    pubkeys: Vector<t, Secp256k1Point>,
    signatures: Vector<t, Secp256k1EcdsaSignature>
  ): ShieldedSendResult {
    // Increment nonce
    const currentNonce = _nonce;
    _nonce.increment(1);

    // Construct message hash
    const msgHash = Eip712_hashTypedData(_domainSeparator, keccak256<Vector<7, Bytes<32>>>([
      EXECUTE_TYPEHASH(),
      // Binds the digest to this deployment. The domain cannot carry the
      // address, so removing this word removes cross-instance replay
      // protection.
      kernel.self().bytes,
      EvmAbi_uint64Word(currentNonce),
      EvmAbi_uint8Word(to.kind as Uint<8>),
      to.address,
      coin.color,
      EvmAbi_uint128Word(amount)
    ]));

    Secp256k1EcdsaMultisig_assertApprovals(msgHash, pubkeys, signatures);

    assert(
      to.kind == Proposal_RecipientKind.ShieldedUser,
      "NativeShieldedStatelessTreasury: recipient must be a coin public key"
    );
    const recipient = left<ZswapCoinPublicKey, ContractAddress>(
      ZswapCoinPublicKey { bytes: to.address }
    );
    return Treasury__send(coin, recipient, amount);
  }

  /**
   * @description Returns the nonce the next `execute` digest will bind to.
   *
   * @constraints k=6, rows=34
   *
   * @returns {Uint<64>} The current nonce.
   */
  export circuit getNonce(): Uint<64> {
    return _nonce;
  }

  /**
   * @description Returns the number of registered signers.
   *
   * @constraints k=6, rows=34
   *
   * @returns {Uint<8>} The signer count.
   */
  export circuit getSignerCount(): Uint<8> {
    return Secp256k1EcdsaMultisig_getSignerCount();
  }

  /**
   * @description Returns the approval threshold.
   *
   * @constraints k=6, rows=34
   *
   * @returns {Uint<8>} The threshold.
   */
  export circuit getThreshold(): Uint<8> {
    return Secp256k1EcdsaMultisig_getThreshold();
  }

  /**
   * @description Returns whether the given commitment is a registered signer.
   *
   * @constraints k=8, rows=129
   *
   * @param {Bytes<32>} commitment - The signer commitment to check.
   * @returns {Boolean} True if registered.
   */
  export circuit isSigner(commitment: Bytes<32>): Boolean {
    return Secp256k1EcdsaMultisig_isSigner(commitment);
  }
}
