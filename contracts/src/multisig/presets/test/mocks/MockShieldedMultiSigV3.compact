// WARNING: FOR TESTING PURPOSES ONLY.
// This contract exposes internal circuits and bypasses safety checks that the
// corresponding production contract relies on. DO NOT deploy or use this
// contract in any production application.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "../../ShieldedMultiSigV3" prefix ShieldedMultiSigV3_;

export { ZswapCoinPublicKey, ContractAddress, Either, Maybe };
export { ShieldedCoinInfo, QualifiedShieldedCoinInfo };

import { _counter, _coinNonce, _tokenDomain } from "../../ShieldedMultiSigV3";
export { _counter, _coinNonce, _tokenDomain };

/**
 * @description `isInit` is a param for testing.
 *
 * If `isInit` is false, the constructor will not initialize the contract,
 * leaving the signer registry empty so the pre-initialization guards can be
 * exercised. The preset `initialize` is intentionally NOT exposed as a
 * circuit: it writes the `sealed` `_tokenDomain`, which the sealed-write rule
 * confines to constructor execution.
*/
constructor(
  instanceSalt: Bytes<32>,
  initCoinNonce: Bytes<32>,
  tokenDomain: Bytes<32>,
  signerCommitments: Vector<3, Bytes<32>>,
  isInit: Boolean
) {
  if (disclose(isInit)) {
    ShieldedMultiSigV3_initialize(
      instanceSalt,
      initCoinNonce,
      tokenDomain,
      signerCommitments
    );
  }
}

export circuit mint(
  amount: Uint<64>,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  pubkeys: Vector<2, Secp256k1Point>,
  signatures: Vector<2, Secp256k1EcdsaSignature>
): [] {
  return ShieldedMultiSigV3_mint(amount, recipient, pubkeys, signatures);
}

export circuit burn(
  coin: QualifiedShieldedCoinInfo,
  amount: Uint<64>,
  pubkeys: Vector<2, Secp256k1Point>,
  signatures: Vector<2, Secp256k1EcdsaSignature>
): [] {
  return ShieldedMultiSigV3_burn(coin, amount, pubkeys, signatures);
}

export pure circuit _calculateSignerId(
  pk: Secp256k1Point,
  salt: Bytes<32>
): Bytes<32> {
  return ShieldedMultiSigV3__calculateSignerId(pk, salt);
}

export circuit getNonce(): Uint<64> {
  return ShieldedMultiSigV3_getNonce();
}

export circuit getTokenDomain(): Bytes<32> {
  return ShieldedMultiSigV3_getTokenDomain();
}

export circuit getTokenType(): Bytes<32> {
  return ShieldedMultiSigV3_getTokenType();
}

export circuit getSignerCount(): Uint<8> {
  return ShieldedMultiSigV3_getSignerCount();
}

export circuit getThreshold(): Uint<8> {
  return ShieldedMultiSigV3_getThreshold();
}

export circuit isSigner(commitment: Bytes<32>): Boolean {
  return ShieldedMultiSigV3_isSigner(commitment);
}
