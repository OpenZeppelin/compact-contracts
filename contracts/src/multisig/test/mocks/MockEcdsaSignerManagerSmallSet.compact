// WARNING: FOR TESTING PURPOSES ONLY.
// This contract exposes internal circuits and bypasses safety checks that the
// corresponding production contract relies on. DO NOT deploy or use this
// contract in any production application.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "../../EcdsaSignerManager" prefix EcdsaSignerManager_;

/**
 * @description Registers the two commitments, or only the first when
 * `soloSigner` is true, for the 1-of-1, 1-of-2 and 2-of-2 sets the main
 * mock's fixed `Vector<3>` cannot reach. `assertSoloApproval` is the width a
 * one-signer consumer uses.
 */
constructor(
  instanceSalt: Bytes<32>,
  signerCommitments: Vector<2, Bytes<32>>,
  threshold: Uint<8>,
  soloSigner: Boolean
) {
  if (disclose(soloSigner)) {
    EcdsaSignerManager_initialize<1>(instanceSalt, [signerCommitments[0]], threshold);
  } else {
    EcdsaSignerManager_initialize<2>(instanceSalt, signerCommitments, threshold);
  }
}

export circuit assertApprovals(
  msgHash: Bytes<32>,
  approvals: Vector<2, Maybe<EcdsaSignerManager_Approval>>
): [] {
  return EcdsaSignerManager_assertApprovals<2>(msgHash, approvals);
}

export circuit assertSoloApproval(
  msgHash: Bytes<32>,
  approvals: Vector<1, Maybe<EcdsaSignerManager_Approval>>
): [] {
  return EcdsaSignerManager_assertApprovals<1>(msgHash, approvals);
}

export circuit getSignerCount(): Uint<8> {
  return EcdsaSignerManager_getSignerCount();
}

export circuit getThreshold(): Uint<8> {
  return EcdsaSignerManager_getThreshold();
}
