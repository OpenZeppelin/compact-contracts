pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "../../EcdsaMultisig"<2> prefix EcdsaMultisig_;

/**
 * @description `isInit` false skips `initialize`. `reinitialize` true calls it
 * a second time to exercise the once-only guard.
 */
constructor(
  instanceSalt: Bytes<32>,
  signerCommitments: Vector<3, Bytes<32>>,
  isInit: Boolean,
  reinitialize: Boolean
) {
  if (disclose(isInit)) {
    EcdsaMultisig_initialize<3>(instanceSalt, signerCommitments);
    if (disclose(reinitialize)) {
      EcdsaMultisig_initialize<3>(instanceSalt, signerCommitments);
    }
  }
}

export circuit assertApprovals(
  msgHash: Bytes<32>,
  pubkeys: Vector<2, Secp256k1Point>,
  signatures: Vector<2, Secp256k1EcdsaSignature>
): [] {
  return EcdsaMultisig_assertApprovals(msgHash, pubkeys, signatures);
}

export pure circuit calculateSignerId(
  pk: Secp256k1Point,
  salt: Bytes<32>
): Bytes<32> {
  return EcdsaMultisig_calculateSignerId(pk, salt);
}

export circuit getSignerCount(): Uint<8> {
  return EcdsaMultisig_getSignerCount();
}

export circuit getThreshold(): Uint<8> {
  return EcdsaMultisig_getThreshold();
}

export circuit isSigner(commitment: Bytes<32>): Boolean {
  return EcdsaMultisig_isSigner(commitment);
}
