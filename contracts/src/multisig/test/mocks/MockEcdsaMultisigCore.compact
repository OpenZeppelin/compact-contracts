// WARNING: FOR TESTING PURPOSES ONLY.
// This contract exposes internal circuits and bypasses safety checks that the
// corresponding production contract relies on. DO NOT deploy or use this
// contract in any production application.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "../../EcdsaMultisigCore" prefix EcdsaMultisigCore_;

/**
 * @description Three signers at a constructor-chosen threshold, with
 * `assertApprovals` at widths 1, 2 and 3; the 2-of-3 mock fixes width 2.
 */
constructor(
  instanceSalt: Bytes<32>,
  signerCommitments: Vector<3, Bytes<32>>,
  threshold: Uint<8>
) {
  EcdsaMultisigCore_initialize<3>(instanceSalt, signerCommitments, threshold);
}

export circuit assertApprovals1Approval(
  msgHash: Bytes<32>,
  pubkeys: Vector<1, Secp256k1Point>,
  signatures: Vector<1, Secp256k1EcdsaSignature>
): [] {
  return EcdsaMultisigCore_assertApprovals<1>(msgHash, pubkeys, signatures);
}

export circuit assertApprovals2Approvals(
  msgHash: Bytes<32>,
  pubkeys: Vector<2, Secp256k1Point>,
  signatures: Vector<2, Secp256k1EcdsaSignature>
): [] {
  return EcdsaMultisigCore_assertApprovals<2>(msgHash, pubkeys, signatures);
}

export circuit assertApprovals3Approvals(
  msgHash: Bytes<32>,
  pubkeys: Vector<3, Secp256k1Point>,
  signatures: Vector<3, Secp256k1EcdsaSignature>
): [] {
  return EcdsaMultisigCore_assertApprovals<3>(msgHash, pubkeys, signatures);
}

export pure circuit calculateSignerId(
  pk: Secp256k1Point,
  salt: Bytes<32>
): Bytes<32> {
  return EcdsaMultisigCore_calculateSignerId(pk, salt);
}

export circuit getSignerCount(): Uint<8> {
  return EcdsaMultisigCore_getSignerCount();
}

export circuit getThreshold(): Uint<8> {
  return EcdsaMultisigCore_getThreshold();
}

export circuit isSigner(commitment: Bytes<32>): Boolean {
  return EcdsaMultisigCore_isSigner(commitment);
}
