// SPDX-License-Identifier: MIT

// WARNING: FOR TESTING PURPOSES ONLY.
// This contract exposes the EvmAbi module's circuits so they can be driven
// directly from off-chain tests. DO NOT deploy or use this contract in any
// production application.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;

import "../../EvmAbi" prefix EvmAbi_;

// Keeps every circuit below impure. Without a ledger write the compiler
// promotes them to pure, and the artifact ships without ZKIR or proving keys,
// leaving the word encoders evaluated but never proven.
ledger _invocations: Counter;

export circuit uint8Word(value: Uint<8>): Bytes<32> {
  _invocations.increment(1);
  return EvmAbi_uint8Word(value);
}

export circuit uint64Word(value: Uint<64>): Bytes<32> {
  _invocations.increment(1);
  return EvmAbi_uint64Word(value);
}

export circuit uint128Word(value: Uint<128>): Bytes<32> {
  _invocations.increment(1);
  return EvmAbi_uint128Word(value);
}

export circuit boolWord(value: Boolean): Bytes<32> {
  _invocations.increment(1);
  return EvmAbi_boolWord(value);
}
