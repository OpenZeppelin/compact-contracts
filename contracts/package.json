{
  "name": "@openzeppelin/compact-contracts",
  "version": "0.5.0-alpha.2",
  "description": "OpenZeppelin Compact contract library",
  "keywords": [
    "openzeppelin",
    "compact",
    "midnight",
    "contracts",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenZeppelin/compact-contracts.git"
  },
  "license": "MIT",
  "author": "OpenZeppelin Community <maintainers@openzeppelin.org>",
  "bugs": {
    "url": "https://github.com/OpenZeppelin/compact-contracts/issues"
  },
  "homepage": "https://docs.openzeppelin.com/contracts-compact/",
  "type": "module",
  "imports": {
    "#test-utils/*": "./test-utils/*"
  },
  "scripts": {
    "compile:access": "rm -rf artifacts/access && compact-compiler +0.36.0 --hierarchical --dir access",
    "compile:archive": "rm -rf artifacts/archive && compact-compiler +0.36.0 --hierarchical --dir archive",
    "compile:crypto": "rm -rf artifacts/crypto && compact-compiler +0.36.0 --hierarchical --dir crypto",
    "compile:math": "rm -rf artifacts/math && compact-compiler +0.36.0 --hierarchical --dir math",
    "compile:multisig": "rm -rf artifacts/multisig && compact-compiler +0.36.0 --hierarchical --dir multisig",
    "compile:security": "rm -rf artifacts/security && compact-compiler +0.36.0 --hierarchical --dir security",
    "compile:token": "rm -rf artifacts/token && compact-compiler +0.36.0 --hierarchical --dir token",
    "compile:utils": "rm -rf artifacts/utils && compact-compiler +0.36.0 --hierarchical --dir utils",
    "compile:integration": "rm -rf artifacts/integration && compact-compiler +0.36.0 --hierarchical --src test/integration/_mocks --out artifacts/integration",
    "build": "compact-builder +0.36.0 --hierarchical --out dist --clean-dist --exclude '*/archive/*' --exclude 'Mock*' --exclude '*.mock.compact' --copy package.json --copy ../README.md && find dist -type d -empty -delete",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:harness": "vitest run --project harness",
    "test:harness:live": "MIDNIGHT_BACKEND=live vitest run --project harness-live",
    "test:scripts": "vitest run --project scripts",
    "types": "tsc -p tsconfig.json --noEmit",
    "clean": "git clean -fXd"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@openzeppelin/compact-cli": "^0.2.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-js": "2.5.5-rc.8",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-beta.7",
    "@midnight-ntwrk/testkit-js": "5.0.0-beta.7",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.4.0",
    "@openzeppelin/compact-deployer": "^0.4.0",
    "@openzeppelin/compact-simulator": "^0.5.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "^5.0.0",
    "ethers": "^6.17.0",
    "fast-check": "^4.10.1",
    "pino": "^10.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
